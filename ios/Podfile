platform :ios, '15.1'
ENV['RCT_NEW_ARCH_ENABLED'] ||= '0'

# ✅ RN iOS autolinking 스크립트 로드 (양쪽 경로 시도 + 폴백)
begin
  require_relative '../node_modules/@react-native-community/cli-platform-ios/native_modules'
rescue LoadError
  begin
    require_relative '../node_modules/@react-native/cli-platform-ios/native_modules'
  rescue LoadError
    Pod::UI.puts '⚠️  RN iOS autolinking script not found; continuing without it'
    def use_native_modules!(*args); end
  end
end

require_relative '../node_modules/react-native/scripts/react_native_pods'
prepare_react_native_project!  # ✅ React Native 표준 초기화

# ✅ Expo autolinking (없어도 빌드 진행되도록 폴백)
begin
  require_relative '../node_modules/expo-modules-autolinking/scripts/autolinking'
rescue LoadError
  begin
    require_relative '../node_modules/expo-modules-autolinking/build/scripts/autolinking'
  rescue LoadError
    Pod::UI.puts '⚠️  expo-modules-autolinking not found; continuing without it'
    def use_expo_modules!(*args); end
    module Expo; module PostInstall; def self.install!(*args); end; end; end
  end
end

use_frameworks! :linkage => :static
$RNReanimated = { :codegen_disabled => true } # Old Arch에서 Reanimated codegen 비활성

# ✅ .xcodeproj 동적 감지 (이름/유무 차이 자동 처리)
xcodeproj_path = Dir.glob(File.join(__dir__, '*.xcodeproj')).first
if xcodeproj_path.nil?
  Pod::UI.puts "❌ No .xcodeproj found under ios/. Make sure to commit ios/ or let CI run Expo prebuild."
  raise "Missing Xcode project"
end
xcodeproj_name = File.basename(xcodeproj_path)               # e.g. "PickPlay.xcodeproj"
target_name    = File.basename(xcodeproj_path, '.xcodeproj') # e.g. "PickPlay"

project xcodeproj_name

target target_name do
  use_expo_modules!   # 있으면 사용

  # ✅ RN autolinking (config 받아서 reactNativePath 사용)
  config = use_native_modules!

  use_react_native!(
    :path => (config && config[:reactNativePath]) || '../node_modules/react-native',
    :hermes_enabled => true,
    :fabric_enabled => false,   # Old Architecture
    :app_path => ".."
  )

  # (선택) Firebase 직접 핀 — RNFirebase를 안 쓸 때만 유지
  firebase_version = '10.25.0'
  pod 'FirebaseCore', firebase_version
  pod 'FirebaseCoreInternal', firebase_version
  pod 'FirebaseAuth', firebase_version
  pod 'FirebaseFirestore', firebase_version
  pod 'FirebaseFunctions', firebase_version
end

post_install do |installer|
  puts "🔧 [post_install] Custom Podfile post_install hook executing..."
  react_native_post_install(installer)
  Expo::PostInstall.install!(installer)

  # === 아래는 기존 커스텀 유지 ===
  installer.pods_project.targets.each do |target|
    target_name = target.name.to_s
    if target_name == 'GoogleUserMessagingPlatform'
      target.build_phases.each do |phase|
        if phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase) && phase.name == '[CP] Copy XCFrameworks'
          phase.run_only_for_deployment_postprocessing = 0
        end
      end
    end
  end

  # === 커스텀 빌드 설정 ===
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      name = target.name.to_s

      old_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if old_target && (old_target.to_f < 15.1)
        puts "⚠️ [#{name}] iOS deployment target 업그레이드: #{old_target} → 15.1"
      end
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'

      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      if name.include?('Google') || name.include?('Firebase')
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['ALWAYS_SEARCH_USER_PATHS'] = 'NO'
        config.build_settings['DEFINES_MODULE'] = 'YES'
      end
      config.build_settings['SWIFT_VERSION'] = '5.0'
      if config.name == 'Debug'
        config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone'
      else
        config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-O'
      end
      config.build_settings['GCC_OPTIMIZATION_LEVEL'] = '0'
      config.build_settings['SWIFT_COMPILATION_MODE'] = 'wholemodule'
      config.build_settings['VALIDATE_PRODUCT'] = 'NO'
      config.build_settings['SKIP_INSTALL'] = 'YES'
      config.build_settings['SUPPORTED_PLATFORMS'] = 'iphoneos iphonesimulator'
      config.build_settings['TARGETED_DEVICE_FAMILY'] = '1,2'
      
      # ✅ Pods 타겟은 프로비저닝 프로파일 불필요 → "Automatic" 또는 제거
      config.build_settings['PROVISIONING_PROFILE_SPECIFIER'] = ''
      config.build_settings['CODE_SIGN_STYLE'] = 'Automatic'
      config.build_settings.delete('PROVISIONING_PROFILE_SPECIFIER')

      # ✅ BoringSSL-GRPC: -G 플래그 근본 차단 (pod install 시 즉시 적용)
      if target.name == 'BoringSSL-GRPC'
        %w[OTHER_CFLAGS OTHER_CPLUSPLUSFLAGS GCC_PREPROCESSOR_DEFINITIONS].each do |flag|
          flags = config.build_settings[flag]
          next unless flags

          if flags.is_a?(String)
            flags.gsub!(/\s-G(\s|$)/, ' ')
            config.build_settings[flag] = flags
          elsif flags.is_a?(Array)
            flags.map! { |s| s.gsub(/\s-G(\s|$)/, ' ') }
            config.build_settings[flag] = flags
          end
        end
        
        # 개별 소스 파일의 COMPILER_FLAGS에서도 -G 제거
        g_pattern = /(^|\s)-G(?=\s|$)/
        target.build_phases.grep(Xcodeproj::Project::Object::PBXSourcesBuildPhase).each do |phase|
          phase.files.each do |bf|
            next unless bf.settings
            flags = bf.settings['COMPILER_FLAGS']
            next unless flags
            
            if flags.is_a?(String) && flags.match?(g_pattern)
              cleaned = flags.gsub(g_pattern, ' ').squeeze(' ').strip
              bf.settings['COMPILER_FLAGS'] = cleaned.empty? ? '' : cleaned
            elsif flags.is_a?(Array) && flags.any? { |s| s.to_s.match?(g_pattern) }
              cleaned = flags.map { |s| s.to_s.gsub(g_pattern, ' ').squeeze(' ').strip }.reject(&:empty?)
              bf.settings['COMPILER_FLAGS'] = cleaned.empty? ? '' : cleaned
            end
          end
        end
        puts "✅ [BoringSSL-GRPC] -G 플래그 제거 완료"
      end

      if name.include?('ReactNativeDependencies')
        config.build_settings['RUN_CLANG_STATIC_ANALYZER'] = 'NO'
        config.build_settings['CLANG_ANALYZER_LOCALIZABILITY_NONLOCALIZED'] = 'NO'
      end
    end
  end

  puts "✅ [post_install] Custom build settings applied successfully"
end
