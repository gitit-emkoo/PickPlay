source 'https://cdn.cocoapods.org/'
require_relative '../node_modules/react-native/scripts/react_native_pods'

begin
  require_relative '../node_modules/react-native/scripts/react_native_post_install'
rescue LoadError
  Pod::UI.puts '⚠️  react_native_post_install not found; continuing without it'
  def react_native_post_install(*); end
end

  begin
  require_relative '../node_modules/expo/scripts/autolinking'
  rescue LoadError
  Pod::UI.puts '⚠️  expo autolinking script not found; continuing without it'
  def use_expo_modules!(*); end
end

platform :ios, '15.1'
project 'PickPlay.xcodeproj'

target 'PickPlay' do
  use_expo_modules!

  # New Architecture 명시적으로 비활성화
  ENV['RCT_NEW_ARCH_ENABLED'] = '0'

  use_react_native!(
    :hermes_enabled => true,
    :fabric_enabled => false,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Fallback: Ensure RNScreens is resolvable for Expo pods (e.g., ExpoHead)
  if File.exist?(File.join(__dir__, '../node_modules/react-native-screens/RNScreens.podspec'))
    pod 'RNScreens', :path => '../node_modules/react-native-screens'
  end

end

post_install do |installer|
  react_native_post_install(installer)
  
  # React Native Codegen 디렉토리 생성 (New Architecture 비활성화 상태에서도 빌드 스크립트 체크 대응)
  begin
    require 'fileutils'
    repo_root = File.expand_path('..', __dir__)
    codegen_dir = File.join(repo_root, 'ios', 'build', 'generated', 'ios')
    
    # Codegen 디렉토리 생성
    FileUtils.mkdir_p(codegen_dir)
    FileUtils.mkdir_p(File.join(codegen_dir, 'react', 'renderer', 'components'))
    
    # react-native-screens를 위한 Codegen 파일 생성 (실제로는 빌드 시 생성되지만 체크 통과를 위해)
    # New Architecture가 비활성화되어 있으므로 실제 Codegen 파일은 필요 없지만,
    # 빌드 스크립트의 체크를 통과하기 위해 디렉토리 구조는 만들어둠
    puts "📁 Codegen directory created: #{codegen_dir}"
    
    # generate-codegen-artifacts.js 스크립트가 있다면 실행 시도
    codegen_script = File.join(repo_root, 'node_modules', 'react-native', 'scripts', 'generate-codegen-artifacts.js')
    if File.exist?(codegen_script)
      puts "🔧 Running React Native Codegen from Podfile post_install..."
      # New Architecture가 비활성화되어 있어도 스크립트 실행 (에러 무시)
      result = system("cd #{repo_root} && node #{codegen_script} 2>&1")
      unless result
        puts "⚠️ Codegen script returned non-zero (expected when newArchEnabled=false)"
      end
    else
      puts "📝 Codegen script not found (this is OK when newArchEnabled=false)"
    end
  rescue => e
    puts "⚠️ Codegen setup error (can be ignored when newArchEnabled=false): #{e.message}"
  end

  # Pods 프로젝트 루트 빌드 설정에도 C++20 강제 (일부 타겟이 xcconfig로 gnu++14를 참조하는 경우 대비)
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'gnu++20'
    config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
  end

  # RCT-Folly 전용: C++20 표준을 안전하게 강제 적용 (타겟 존재 시에만)
  folly_target = installer.pods_project.targets.find { |t| t.name == 'RCT-Folly' }
  if folly_target
    folly_target.build_configurations.each do |config|
      config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
    end
  end

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # iOS 최소 타겟 상향 (Codegen 생성 Pod 요구 대응)
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
      
      # Hermes/React C++ 컴파일 표준 및 라이브러리 강제 지정 (C++20 표준 사용)
      # React Native 0.76.9+ supports C++20 for better compatibility (concepts, std::thread 등)
      config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'gnu++20'
      config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
      
      # 일부 타겟에서 표준 미반영 시 플래그로 보강 (모든 C++ 파일에 적용)
      cppflags = config.build_settings['OTHER_CPLUSPLUSFLAGS']
      if cppflags.nil?
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = ['-std=gnu++20']
      elsif cppflags.is_a?(String)
        unless cppflags.include?('-std=gnu++20') || cppflags.include?('-std=c++20')
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = cppflags + ' -std=gnu++20'
        end
      elsif cppflags.is_a?(Array)
        unless cppflags.any? { |f| f.to_s.include?('-std=gnu++20') || f.to_s.include?('-std=c++20') }
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = cppflags + ['-std=gnu++20']
        end
      end
      
      # New Architecture 비활성화 (C/C++/Objective-C용)
      # 주의: #ifdef RCT_NEW_ARCH_ENABLED는 값이 0이어도 '정의됨'이면 true가 됩니다.
      # 따라서 매크로를 '정의하지 않도록' 완전히 제거해야 합니다.
      defs = config.build_settings["GCC_PREPROCESSOR_DEFINITIONS"]
      if defs.is_a?(String)
        defs = defs.split(' ')
      elsif defs.nil?
        defs = []
      end
      defs = defs.reject { |d| d.to_s.start_with?("RCT_NEW_ARCH_ENABLED") }
      config.build_settings["GCC_PREPROCESSOR_DEFINITIONS"] = defs
      
      # New Architecture 비활성화 (Swift용)
      # Swift에서 #if RCT_NEW_ARCH_ENABLED는 매크로가 정의되어 있지 않으면 false
      # 따라서 RCT_NEW_ARCH_ENABLED를 제거해야 함
      # 기존에 설정된 RCT_NEW_ARCH_ENABLED 제거
      swift_flags = config.build_settings["OTHER_SWIFT_FLAGS"] || []
      if swift_flags.is_a?(String)
        swift_flags = swift_flags.empty? ? [] : swift_flags.split(' ')
      end
      swift_flags = swift_flags.is_a?(Array) ? swift_flags : []
      # RCT_NEW_ARCH_ENABLED 관련 플래그 제거
      swift_flags = swift_flags.reject { |f| f.to_s.include?('RCT_NEW_ARCH_ENABLED') }
      config.build_settings["OTHER_SWIFT_FLAGS"] = swift_flags
      
      # SWIFT_ACTIVE_COMPILATION_CONDITIONS에서도 RCT_NEW_ARCH_ENABLED 제거
      swift_conditions = config.build_settings["SWIFT_ACTIVE_COMPILATION_CONDITIONS"] || []
      if swift_conditions.is_a?(String)
        swift_conditions = swift_conditions.empty? ? [] : swift_conditions.split(' ')
      end
      swift_conditions = swift_conditions.is_a?(Array) ? swift_conditions : []
      swift_conditions = swift_conditions.reject { |c| c == 'RCT_NEW_ARCH_ENABLED' }
      config.build_settings["SWIFT_ACTIVE_COMPILATION_CONDITIONS"] = swift_conditions.join(' ')
    end
  end
  
  # 검증: 모든 타겟이 C++20 표준을 사용하는지 확인 및 로깅
  begin
    cxx_standard_issues = []
    cxx20_count = 0
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        std = config.build_settings['CLANG_CXX_LANGUAGE_STANDARD']
        if std == 'gnu++20' || std == 'c++20'
          cxx20_count += 1
        elsif std && std != 'gnu++20' && std != 'c++20'
          cxx_standard_issues << "#{target.name} (#{config.name}): #{std}"
        end
      end
    end
    # Root build configurations도 확인
    installer.pods_project.build_configurations.each do |config|
      std = config.build_settings['CLANG_CXX_LANGUAGE_STANDARD']
      if std == 'gnu++20' || std == 'c++20'
        cxx20_count += 1
      end
    end
    Pod::UI.puts "📊 C++ standard summary: #{cxx20_count} config(s) using C++20"
    if cxx_standard_issues.any?
      Pod::UI.puts "⚠️  Warning: Some targets don't have gnu++20:"
      cxx_standard_issues.each { |issue| Pod::UI.puts "   #{issue}" }
    else
      Pod::UI.puts "✅ All Pod targets configured with C++20 standard"
    end
  rescue => e
    Pod::UI.puts "⚠️  C++ standard verification skipped: #{e.message}"
  end

  require 'xcodeproj'

  %w[BoringSSL-GRPC BoringSSL-GRPC-openssl_grpc].each do |target_name|
    installer.pods_project.targets.each do |target|
      next unless target.name == target_name

      # 1) 타겟 레벨 빌드 설정에서 -G 제거 (모든 변형 키 포함)
      flag_keys = %w[
        OTHER_CFLAGS OTHER_CPLUSPLUSFLAGS OTHER_LDFLAGS WARNING_CFLAGS GCC_PREPROCESSOR_DEFINITIONS
        OTHER_CFLAGS[arch=arm64] OTHER_CPLUSPLUSFLAGS[arch=arm64] OTHER_LDFLAGS[arch=arm64]
        OTHER_CFLAGS[sdk=iphoneos*] OTHER_CPLUSPLUSFLAGS[sdk=iphoneos*] OTHER_LDFLAGS[sdk=iphoneos*]
        OTHER_CFLAGS[sdk=iphonesimulator*] OTHER_CPLUSPLUSFLAGS[sdk=iphonesimulator*] OTHER_LDFLAGS[sdk=iphonesimulator*]
      ]

      target.build_configurations.each do |config|
        flag_keys.each do |key|
          val = config.build_settings[key]
          next unless val
          if val.is_a?(String)
            cleaned = val.gsub(/\s-G(\s|$)/, ' ').squeeze(' ').strip
            config.build_settings[key] = cleaned.empty? ? '$(inherited)' : cleaned
          elsif val.is_a?(Array)
            cleaned = val.map { |v| v.to_s.gsub(/\s-G(\s|$)/, ' ').squeeze(' ').strip }.reject(&:empty?)
            config.build_settings[key] = cleaned.empty? ? ['$(inherited)'] : cleaned
          end
        end
      end

      # 2) 개별 소스 파일 컴파일러 플래그에서 -G 제거 (비면 nil)
      g_pattern = /(^|\s)-G(?=\s|$)/
      target.build_phases.grep(Xcodeproj::Project::Object::PBXSourcesBuildPhase).each do |phase|
        phase.files.each do |bf|
          next unless bf.settings
          flags = bf.settings['COMPILER_FLAGS']
          next unless flags
          if flags.is_a?(String)
            cleaned = flags.gsub(g_pattern, ' ').squeeze(' ').strip
            bf.settings['COMPILER_FLAGS'] = cleaned.empty? ? nil : cleaned
          elsif flags.is_a?(Array)
            cleaned = flags.map { |v| v.to_s.gsub(g_pattern, ' ').squeeze(' ').strip }.reject(&:empty?)
            bf.settings['COMPILER_FLAGS'] = cleaned.empty? ? nil : cleaned
          end
        end
      end

      puts "✅ [#{target_name}] -G scrubbed"
          end
        end

  # 3) openssl_grpc 타겟 자체 제거로 재유입 차단
  begin
    dead = installer.pods_project.targets.find { |t| t.name == 'BoringSSL-GRPC-openssl_grpc' }
    if dead
      installer.pods_project.targets.delete(dead)
      puts "🗑️ Removed target: BoringSSL-GRPC-openssl_grpc"
    end
  rescue => e
    Pod::UI.puts "⚠️ openssl_grpc target removal skipped: #{e.message}"
  end

  # 4) Hermes 스크립트 단계가 CI에서 실패하는 이슈 방지: 스크립트를 no-op 처리
  begin
    hermes = installer.pods_project.targets.find { |t| t.name == 'hermes-engine' }
    if hermes
      hermes.build_phases.grep(Xcodeproj::Project::Object::PBXShellScriptBuildPhase).each do |bp|
        next unless bp.name.to_s.include?('Replace Hermes for the right configuration')
        bp.shell_script = %q(
          echo "[CI] Skipping Hermes replacement script (no-op)."
          exit 0
        ).strip
        puts "🛠️  Hermes replacement script converted to no-op"
      end
    end
  rescue => e
    Pod::UI.puts "⚠️ Hermes script phase tweak skipped: #{e.message}"
  end

  # 5) [RN]Check rncore 스크립트 비활성화 (New Architecture 비활성화 상태에서 Codegen 체크 불필요)
  begin
    react_fabric = installer.pods_project.targets.find { |t| t.name == 'React-Fabric' }
    react_fabric_components = installer.pods_project.targets.find { |t| t.name == 'React-FabricComponents' }
    
    [react_fabric, react_fabric_components].compact.each do |target|
      target.build_phases.grep(Xcodeproj::Project::Object::PBXShellScriptBuildPhase).each do |bp|
        next unless bp.name.to_s.include?('[RN]Check rncore')
        # New Architecture가 비활성화되어 있으므로 Codegen 체크 스크립트를 no-op 처리
        bp.shell_script = %q(
          echo "[CI] Skipping [RN]Check rncore script (newArchEnabled=false)."
          exit 0
        ).strip
        puts "🛠️  [RN]Check rncore script converted to no-op for #{target.name}"
      end
    end
  rescue => e
    Pod::UI.puts "⚠️ [RN]Check rncore script tweak skipped: #{e.message}"
  end

  # 6) ExpoModulesCore 타겟에서 New Architecture 전용 Swift 파일 빌드 제외 및 패치
  # New Architecture가 비활성화된 상태(newArchEnabled=false)에서 Fabric 관련 파일들이 컴파일되면 오류 발생
  # EXCLUDED_SOURCE_FILE_NAMES 빌드 설정을 사용하여 해당 파일들을 빌드에서 제외
  # 참고: Xcode 빌드 설정 공식 방법, Expo 커뮤니티 권장 패턴
  # 의존성 파일들도 함께 제외해야 함 (ExpoFabricView, ExpoSwiftUIView 등을 참조하는 파일들)
  begin
    expo_modules_core = installer.pods_project.targets.find { |t| t.name == 'ExpoModulesCore' }
    if expo_modules_core
      # React Native 0.76에서 import React 모듈 문제 해결
      # React Native 0.76에서는 React 모듈이 React-Core로 변경되었지만,
      # ExpoModulesCore는 여전히 import React를 사용합니다.
      # 따라서 Swift에서 React 모듈을 찾을 수 있도록 모듈 맵 경로를 설정해야 합니다.
      # React 모듈 설정은 아래의 강화된 버전에서 처리됩니다 (497줄 부근)
      # 여기서는 기본 설정만 유지
      expo_modules_core.build_configurations.each do |config|
        # Header Search Paths 기본 설정 (상세 설정은 아래에서 처리)
        header_search_paths = config.build_settings["HEADER_SEARCH_PATHS"] || []
        if header_search_paths.is_a?(String)
          header_search_paths = header_search_paths.empty? ? [] : header_search_paths.split(' ').uniq
        end
        header_search_paths = header_search_paths.is_a?(Array) ? header_search_paths.dup : []
        
        react_header_paths = [
          '$(PODS_ROOT)/Headers/Private/React-Core',
          '$(PODS_CONFIGURATION_BUILD_DIR)/React-Core',
          '$(PODS_ROOT)/Headers/Public/React-Core'
        ]
        react_header_paths.each do |path|
          header_search_paths << path unless header_search_paths.include?(path)
        end
        
        config.build_settings["HEADER_SEARCH_PATHS"] = (header_search_paths + ['$(inherited)']).uniq.join(' ')
        
        # Swift Import Paths 기본 설정 (상세 설정은 아래에서 처리)
        import_paths = config.build_settings["SWIFT_INCLUDE_PATHS"] || []
        if import_paths.is_a?(String)
          import_paths = import_paths.empty? ? [] : import_paths.split(' ').uniq
        end
        import_paths = import_paths.is_a?(Array) ? import_paths.dup : []
        
        react_import_paths = [
          '$(PODS_CONFIGURATION_BUILD_DIR)/React-Core',
          '$(PODS_ROOT)/Headers/Private/React-Core',
          '$(PODS_ROOT)/Headers/Public/React-Core'
        ]
        react_import_paths.each do |path|
          import_paths << path unless import_paths.include?(path)
        end

        config.build_settings["SWIFT_INCLUDE_PATHS"] = (import_paths + ['$(inherited)']).uniq.join(' ')
      end
      
      # ExpoModulesCore 타겟이 React-Core에 의존하는지 확인
      # React Native 0.76에서는 use_react_native!가 자동으로 React-Core를 링크합니다.
      react_core_dep = expo_modules_core.dependencies.find { |d| d.name == 'React-Core' }
      unless react_core_dep
        puts "⚠️ ExpoModulesCore may need React-Core dependency (check if use_react_native! sets it)"
      else
        puts "✅ ExpoModulesCore depends on React-Core"
      end
      # Fabric/SwiftUI 관련 파일 및 이를 참조하는 의존성 파일들 제외
      # 주의: 
      # - CommonExceptions.swift는 제외하면 안 됨 (Exceptions struct 정의)
      # - ViewDefinition.swift는 제외하면 안 됨 (AnyViewDefinitionElement 정의)
      # - ViewDefinition.swift의 Fabric 코드는 #if RCT_NEW_ARCH_ENABLED로 보호됨
      # ExpoFabricView.swift와 대부분의 Fabric 파일들은 #if RCT_NEW_ARCH_ENABLED로 보호되어 있음
      # 따라서 파일을 제외할 필요 없이 RCT_NEW_ARCH_ENABLED가 false면 자동으로 제외됨
      # 하지만 ExpoSwiftUI 관련 파일들은 조건부 컴파일이 없으므로 제외 필요
      excluded_files = [
        # SwiftUI New Architecture 핵심 파일 (조건부 컴파일 없음)
        'SwiftUIHostingView.swift',
        'SwiftUIViewDefinition.swift',
        'SwiftUIViewDefinitionBuilder.swift',
        # ExpoSwiftUIView를 참조하는 파일 (조건부 컴파일 없음)
        'DynamicSwiftUIViewType.swift',  # ExpoSwiftUIView, AnyExpoSwiftUIHostingView 참조
        # 조건부 참조 파일 (부분적으로 Fabric/SwiftUI 의존, 조건부 컴파일 없음)
        'ComponentData.swift'  # ExpoSwiftUI.AnyHostingView 참조
        # ExpoFabricView.swift는 제외하지 않음 (#if RCT_NEW_ARCH_ENABLED로 보호됨)
        # ExpoView.swift는 제외하지 않음 (typealias는 조건부 컴파일로 보호될 수 있음)
        # CommonExceptions.swift는 제외하지 않음 (Exceptions struct가 필요)
        #   SwiftUIViewNotFound 클래스는 파일 패치로 주석 처리
        # ViewDefinition.swift는 제외하지 않음 (AnyViewDefinitionElement 정의)
        #   Fabric 관련 코드는 #if RCT_NEW_ARCH_ENABLED로 보호되어 있음
        # ViewDefinitionBuilder.swift는 제외하지 않음 (AnyViewDefinitionElement 사용)
        # AnyViewProp.swift는 제외하지 않음 (AnyViewDefinitionElement 사용)
        # ViewFactories.swift는 제외하지 않음 (일반 View 함수 포함, ExpoSwiftUI 함수는 패치 필요)
      ]
      
      # 빌드 설정에 EXCLUDED_SOURCE_FILE_NAMES 추가 (모든 빌드 구성에 적용)
      expo_modules_core.build_configurations.each do |config|
        existing_excluded = config.build_settings['EXCLUDED_SOURCE_FILE_NAMES'] || ''
        
        # 기존 제외 항목과 새 파일을 합침 (중복 방지)
        if existing_excluded.is_a?(String)
          existing_list = existing_excluded.empty? ? [] : existing_excluded.split(' ')
        else
          existing_list = existing_excluded.is_a?(Array) ? existing_excluded : []
        end
        
        # 새 파일 추가 (중복되지 않는 경우만)
        excluded_files.each do |file|
          existing_list << file unless existing_list.include?(file)
        end
        
        config.build_settings['EXCLUDED_SOURCE_FILE_NAMES'] = existing_list.join(' ')
        puts "✅ Excluded Fabric/SwiftUI files from ExpoModulesCore (#{config.name}): #{excluded_files.length} files"
      end
      
      # CommonExceptions.swift의 SwiftUIViewNotFound 클래스를 주석 처리
      # ExpoSwiftUIView가 정의되지 않아 타입 체크 에러 발생 방지
      # (비활성화) 빌드 중괄호 불일치 등 부작용 방지
      if false
      begin
        require 'fileutils'
        repo_root = File.expand_path('..', __dir__)
        common_exceptions_file = File.join(repo_root, 'node_modules', 'expo-modules-core', 'ios', 'Core', 'Exceptions', 'CommonExceptions.swift')
        
        if File.exist?(common_exceptions_file)
          content = File.read(common_exceptions_file)
          
          # SwiftUIViewNotFound 클래스 정의 전체를 주석 처리
          if content.include?('SwiftUIViewNotFound') && !content.include?('// public final class SwiftUIViewNotFound')
            lines = content.lines
            patched_lines = []
            skip_next = false
            
            lines.each_with_index do |line, idx|
              if line.include?('SwiftUIViewNotFound') && !line.strip.start_with?('//')
                # SwiftUIViewNotFound 클래스 시작 줄 주석 처리
                patched_lines << line.gsub(/^(  )/, '\1// ') # 주석 처리
                skip_next = true
              elsif skip_next && line.strip.start_with?('override')
                # override 줄 주석 처리
                patched_lines << line.gsub(/^(    )/, '\1// ')
              elsif skip_next && line.strip.start_with?('}')
                # 클래스 닫는 중괄호 주석 처리
                patched_lines << line.gsub(/^(  )/, '\1// ')
                skip_next = false
              elsif skip_next
                # 클래스 내부 줄들 주석 처리 (빈 줄 제외)
                if line.strip.empty?
                  patched_lines << line
                else
                  patched_lines << line.gsub(/^(    )/, '\1// ')
                end
              else
                patched_lines << line
          end
        end

            File.write(common_exceptions_file, patched_lines.join)
            puts "✅ Patched CommonExceptions.swift: SwiftUIViewNotFound commented out"
          else
            puts "⚠️ SwiftUIViewNotFound not found or already patched in CommonExceptions.swift"
          end
        else
          puts "⚠️ CommonExceptions.swift not found at expected path"
        end
      rescue => e
        Pod::UI.puts "⚠️ CommonExceptions.swift patch skipped: #{e.message}"
        Pod::UI.puts "   Stack trace: #{e.backtrace.first(3).join("\n   ")}"
      end
      end
      
      # ExpoModulesCore Swift 파일들의 import React를 환경별로 안전하게 처리
      # - RN 0.76/Xcode 16 조합에서 상위 모듈명이 React-Core로 노출되는 환경이 있어
      #   Swift에서 'import React'가 실패할 수 있음 → canImport로 React / React_Core를 분기 임포트
      begin
        expo_ios_dir = File.join(repo_root, 'node_modules', 'expo-modules-core', 'ios')
        if Dir.exist?(expo_ios_dir)
          Dir.glob(File.join(expo_ios_dir, '**', '*.swift')).each do |swift_file|
            begin
              content = File.read(swift_file)
              original_content = content.dup
              
              # 1. 'import React' 패치
              if content.include?('import React') && !content.include?('#if canImport(React)')
                content.gsub!(/^\s*import\s+React\s*$/, <<~SWIFT.chomp
                  #if canImport(React)
                  import React
                  #elseif canImport(React_Core)
                  import React_Core
                  #endif
                SWIFT
                )
              end

              # 2. 'import React_RCTAppDelegate' 패치
              if content.include?('import React_RCTAppDelegate') && !content.include?('#if canImport(React_RCTAppDelegate)')
                content.gsub!(/^\s*import\s+React_RCTAppDelegate\s*$/, <<~SWIFT.chomp
                  #if canImport(React_RCTAppDelegate)
                  import React_RCTAppDelegate
                  #endif
                SWIFT
                )
              end

              if content != original_content
                File.write(swift_file, content)
                puts "✅ Patched module imports in #{swift_file.sub(repo_root + '/', '')}"
              end
            rescue => e
              Pod::UI.puts "⚠️ Failed to patch module import in #{swift_file}: #{e.message}"
            end
          end
        end
      rescue => e
        Pod::UI.puts "⚠️ ExpoModulesCore module import patch skipped: #{e.message}"
      end

      # ViewFactories.swift의 ExpoSwiftUI 관련 함수들을 조건부 컴파일로 감싸기
      # ExpoSwiftUI 타입이 정의되지 않아 타입 체크 에러 발생 방지
      begin
        require 'fileutils'
        repo_root = File.expand_path('..', __dir__)
        view_factories_file = File.join(repo_root, 'node_modules', 'expo-modules-core', 'ios', 'Api', 'Factories', 'ViewFactories.swift')
        
        if File.exist?(view_factories_file)
          content = File.read(view_factories_file)
          
          # ExpoSwiftUI 관련 함수들을 #if RCT_NEW_ARCH_ENABLED로 감싸기
          if content.include?('ExpoSwiftUI.View') && !content.include?('#if RCT_NEW_ARCH_ENABLED')
            lines = content.lines.to_a
            patched_lines = []
            in_swiftui_section = false
            swiftui_start_idx = nil
            
            lines.each_with_index do |line, idx|
              # 첫 번째 ExpoSwiftUI 함수 시작 지점 찾기 (주석 포함)
              if !in_swiftui_section && line.include?('Creates a view definition describing the native SwiftUI view')
                in_swiftui_section = true
                patched_lines << "#if RCT_NEW_ARCH_ENABLED\n"
                patched_lines << line
              # 마지막 ExpoSwiftUI 함수 종료 지점 찾기 (다음 MARK 또는 일반 함수)
              elsif in_swiftui_section && (line.strip.start_with?('// MARK:') || (line.include?('public func View') && !line.include?('ExpoSwiftUI')))
                patched_lines << "\n#endif\n"
                patched_lines << line
                in_swiftui_section = false
              elsif in_swiftui_section && idx == lines.length - 1
                # 파일 끝일 때
                patched_lines << line
                patched_lines << "\n#endif\n"
                in_swiftui_section = false
              else
                patched_lines << line
    end
  end
    
            File.write(view_factories_file, patched_lines.join)
            puts "✅ Patched ViewFactories.swift: ExpoSwiftUI functions wrapped in #if RCT_NEW_ARCH_ENABLED"
          elsif content.include?('#if RCT_NEW_ARCH_ENABLED')
            puts "⚠️ ViewFactories.swift already patched"
          else
            puts "⚠️ ExpoSwiftUI functions not found in ViewFactories.swift"
          end
        else
          puts "⚠️ ViewFactories.swift not found at expected path"
        end
      rescue => e
        Pod::UI.puts "⚠️ ViewFactories.swift patch skipped: #{e.message}"
        Pod::UI.puts "   Stack trace: #{e.backtrace.first(3).join("\n   ")}"
      end
      
      # React Native 0.76에서 import React 모듈 문제 해결 (강화 버전)
      # React Native 0.76에서는 React 모듈이 React-Core로 통합되었지만,
      # ExpoModulesCore는 여전히 `import React`를 사용합니다.
      # 모든 빌드 설정에 모듈 경로와 프레임워크 링크를 명시적으로 추가합니다.
      begin
        react_core_target = installer.pods_project.targets.find { |t| t.name == 'React-Core' }
        if react_core_target && expo_modules_core
          expo_modules_core.build_configurations.each do |config|
            # 1. Header Search Paths 추가
            header_search_paths = config.build_settings['HEADER_SEARCH_PATHS'] || []
            if header_search_paths.is_a?(String)
              header_search_paths = header_search_paths.empty? ? [] : header_search_paths.split(' ').uniq
            end
            header_search_paths = header_search_paths.is_a?(Array) ? header_search_paths.dup : []
            
            react_paths = [
              '$(PODS_ROOT)/Headers/Private/React-Core',
              '$(PODS_CONFIGURATION_BUILD_DIR)/React-Core/React-Core.framework/Headers',
              '$(PODS_ROOT)/Headers/Public/React-Core',
              '$(PODS_ROOT)/Headers/Public/React'
            ]
            
            react_paths.each do |path|
              header_search_paths << path unless header_search_paths.include?(path)
            end
            # React-RCTAppDelegate 헤더 경로 추가
            rctapp_header_paths = [
              '$(PODS_ROOT)/Headers/Private/React-RCTAppDelegate',
              '$(PODS_CONFIGURATION_BUILD_DIR)/React-RCTAppDelegate',
              '$(PODS_ROOT)/Headers/Public/React-RCTAppDelegate'
            ]
            rctapp_header_paths.each do |path|
              header_search_paths << path unless header_search_paths.include?(path)
            end
            
            config.build_settings['HEADER_SEARCH_PATHS'] = header_search_paths.join(' ')
            
            # 2. Swift Include Paths 추가 (Swift 컴파일러가 모듈을 찾을 수 있도록)
            swift_include_paths = config.build_settings['SWIFT_INCLUDE_PATHS'] || []
            if swift_include_paths.is_a?(String)
              swift_include_paths = swift_include_paths.empty? ? [] : swift_include_paths.split(' ').uniq
            end
            swift_include_paths = swift_include_paths.is_a?(Array) ? swift_include_paths.dup : []
            
            swift_react_paths = [
              '$(PODS_CONFIGURATION_BUILD_DIR)/React-Core',
              '$(PODS_ROOT)/Headers/Private/React-Core',
              '$(PODS_ROOT)/Headers/Public/React-Core'
            ]
            
            swift_react_paths.each do |path|
              swift_include_paths << path unless swift_include_paths.include?(path)
            end
            # React-RCTAppDelegate Swift 경로 추가
            rctapp_swift_paths = [
              '$(PODS_CONFIGURATION_BUILD_DIR)/React-RCTAppDelegate',
              '$(PODS_ROOT)/Headers/Private/React-RCTAppDelegate',
              '$(PODS_ROOT)/Headers/Public/React-RCTAppDelegate'
            ]
            rctapp_swift_paths.each do |path|
              swift_include_paths << path unless swift_include_paths.include?(path)
            end
            
            config.build_settings['SWIFT_INCLUDE_PATHS'] = swift_include_paths.join(' ')
            
            # 3. OTHER_SWIFT_FLAGS 보수 설정(모듈맵 직접 주입 제거)
            swift_flags = config.build_settings['OTHER_SWIFT_FLAGS'] || []
            if swift_flags.is_a?(String)
              swift_flags = swift_flags.empty? ? [] : swift_flags.split(' ').uniq
            end
            swift_flags = swift_flags.is_a?(Array) ? swift_flags.dup : []

            # 필요시 C 헤더 포함 경로만 유지 (-I)
            include_flags = ['-Xcc', '-I$(PODS_CONFIGURATION_BUILD_DIR)/React-Core', '-Xcc', '-I$(PODS_CONFIGURATION_BUILD_DIR)/React-RCTAppDelegate']
            include_flags.each do |flag|
              swift_flags << flag unless swift_flags.include?(flag)
            end

            # Swift 드라이버가 인식하지 못하는 modulemap 강제 지정은 제거
            swift_flags = swift_flags.reject { |f| f.to_s.start_with?('-fmodule-map-file=') }

            config.build_settings['OTHER_SWIFT_FLAGS'] = swift_flags.join(' ')
            
            # 4. 프레임워크 링크 확인 및 추가
            frameworks_phase = expo_modules_core.build_phases.find { |phase| phase.is_a?(Xcodeproj::Project::Object::PBXFrameworksBuildPhase) }
            if frameworks_phase
              react_core_linked = frameworks_phase.files.any? { |f| 
                f.file_ref && (f.file_ref.path == 'React-Core' || f.file_ref.path == 'React-Core.framework')
              }
              
              unless react_core_linked
                # React-Core 프레임워크 참조 찾기
                react_core_ref = expo_modules_core.project.frameworks_group.files.find { |f| 
                  f.path == 'React-Core' || f.path == 'React-Core.framework'
                }
                
                if react_core_ref.nil?
                  # 직접 프레임워크 참조 생성
                  react_core_path = '$(PODS_CONFIGURATION_BUILD_DIR)/React-Core/React-Core.framework'
                  file_ref = expo_modules_core.project.new_file(react_core_path)
                  frameworks_phase.add_file_reference(file_ref)
                  puts "✅ Added React-Core framework reference to ExpoModulesCore (dynamic)"
                else
                  frameworks_phase.add_file_reference(react_core_ref)
                  puts "✅ Added React-Core framework reference to ExpoModulesCore"
                end
              end
            end
          end
          
          puts "✅ React module configuration applied to ExpoModulesCore"
        end
      rescue => e
        Pod::UI.puts "⚠️ React-Core configuration skipped: #{e.message}"
        Pod::UI.puts "   Stack trace: #{e.backtrace.first(5).join("\n   ")}"
      end
      
      # react-native-screens의 New Architecture 코드 문제 해결
      # 모든 .mm과 .h 파일에서 #ifdef/#ifndef RCT_NEW_ARCH_ENABLED를 #if/#if !로 변경
      # 문제: #ifdef/#ifndef는 매크로가 정의되어 있으면 true/false이지만, #if/#if !는 매크로 값에 따라 결정
      # RCT_NEW_ARCH_ENABLED=0으로 설정했을 때:
      #   - #ifdef RCT_NEW_ARCH_ENABLED → true (문제!)
      #   - #ifndef RCT_NEW_ARCH_ENABLED → false (문제!)
      #   - #if RCT_NEW_ARCH_ENABLED → false (올바름)
      #   - #if !RCT_NEW_ARCH_ENABLED → true (올바름)
      begin
        require 'fileutils'
        repo_root = File.expand_path('..', __dir__)
        rns_ios_dir = File.join(repo_root, 'node_modules', 'react-native-screens', 'ios')
        
        if Dir.exist?(rns_ios_dir)
          patched_files = []
          # .mm 파일과 .h 파일 모두 처리
          Dir.glob(File.join(rns_ios_dir, '*.{mm,h}')).each do |source_file|
            begin
              content = File.read(source_file)
              patched_content = content.dup
              changed = false
              
              # #ifdef RCT_NEW_ARCH_ENABLED를 #if RCT_NEW_ARCH_ENABLED로 변경
              if patched_content.include?('#ifdef RCT_NEW_ARCH_ENABLED')
                old_ifdef_count = patched_content.scan(/#ifdef\s+RCT_NEW_ARCH_ENABLED/).length
                patched_content = patched_content.gsub(/#ifdef\s+RCT_NEW_ARCH_ENABLED/, '#if RCT_NEW_ARCH_ENABLED')
                new_if_count = patched_content.scan(/#if\s+RCT_NEW_ARCH_ENABLED/).length
                if old_ifdef_count > 0 && new_if_count >= old_ifdef_count
                  changed = true
                end
              end
              
              # #ifndef RCT_NEW_ARCH_ENABLED를 #if !RCT_NEW_ARCH_ENABLED로 변경
              # NDEBUG는 건너뛰고 RCT_NEW_ARCH_ENABLED만 변경
              if patched_content.include?('#ifndef RCT_NEW_ARCH_ENABLED')
                old_ifndef_count = patched_content.scan(/#ifndef\s+RCT_NEW_ARCH_ENABLED/).length
                patched_content = patched_content.gsub(/#ifndef\s+RCT_NEW_ARCH_ENABLED/, '#if !RCT_NEW_ARCH_ENABLED')
                new_if_not_count = patched_content.scan(/#if\s+!RCT_NEW_ARCH_ENABLED/).length
                if old_ifndef_count > 0 && new_if_not_count >= old_ifndef_count
                  changed = true
                end
              end
              
              # RNSScreenStack.mm의 cancelTouchesInParent 메서드 수정
              # rnscreens_cancelTouches는 New Architecture에서만 사용 가능하므로 조건부로 감싸야 함
              if File.basename(source_file) == 'RNSScreenStack.mm' && patched_content.include?('rnscreens_cancelTouches')
                # cancelTouchesInParent 메서드 내의 rnscreens_cancelTouches 호출을 조건부로 감싸기
                if patched_content.match(/\[\[self rnscreens_findTouchHandlerInAncestorChain\] rnscreens_cancelTouches\];/)
                  patched_content = patched_content.gsub(
                    /(\s+)(\[\[self rnscreens_findTouchHandlerInAncestorChain\] rnscreens_cancelTouches\];)/,
                    "\\1#if RCT_NEW_ARCH_ENABLED\n\\1  \\2\n\\1#endif"
                  )
                  changed = true
                end
              end
              
              # RNSScreen.mm의 rnscreens_findTouchHandlerInAncestorChain 메서드 반환 타입 수정 (여기서는 건너뛰고 아래에서 통합 처리)
              # 이 부분은 아래의 강화된 패치에서 처리됩니다
              
              if changed && patched_content != content
                File.write(source_file, patched_content)
                patched_files << File.basename(source_file)
              end
            rescue => e
              Pod::UI.puts "⚠️ Failed to patch #{File.basename(source_file)}: #{e.message}"
            end
          end
          
          if patched_files.any?
            puts "✅ Patched #{patched_files.length} react-native-screens file(s): Changed #ifdef/#ifndef to #if/#if ! for RCT_NEW_ARCH_ENABLED"
            puts "   Files: #{patched_files.join(', ')}"
            puts "   - This ensures New Architecture code is only compiled when RCT_NEW_ARCH_ENABLED != 0"
          else
            puts "⚠️ No react-native-screens files needed patching (already using #if/#if !)"
          end
          
          # RNSScreenStack.mm의 rnscreens_cancelTouches 호출을 조건부 컴파일로 감싸기
          rnsscreenstack_file = File.join(rns_ios_dir, 'RNSScreenStack.mm')
          if File.exist?(rnsscreenstack_file)
            content = File.read(rnsscreenstack_file)
            if content.include?('rnscreens_cancelTouches') && !content.include?('#if RCT_NEW_ARCH_ENABLED')
              # [[self rnscreens_findTouchHandlerInAncestorChain] rnscreens_cancelTouches]; 패턴 찾기
              patched_content = content.gsub(
                /(\s+)(\[\[self rnscreens_findTouchHandlerInAncestorChain\] rnscreens_cancelTouches\];)/,
                "\\1#if RCT_NEW_ARCH_ENABLED\n\\1  \\2\n\\1#endif"
              )
              if patched_content != content
                File.write(rnsscreenstack_file, patched_content)
                puts "✅ Patched RNSScreenStack.mm: wrapped rnscreens_cancelTouches in #if RCT_NEW_ARCH_ENABLED"
              end
            end
          end
          
          # RNSScreen.mm의 rnscreens_findTouchHandlerInAncestorChain 반환 타입 문제 해결 (최종 강화 버전)
          # 에러: line=633: return (RCTTouchHandler *)_touchHandler; 가 #else 블록에 있어도 메서드 선언부가 문제
          # 메서드 선언부가 RCTSurfaceTouchHandler * _Nullable인데 Legacy Architecture에서는 RCTTouchHandler *를 반환해야 함
          # 해결: 메서드 선언부(.h)와 구현부(.mm) 모두 조건부 컴파일로 감싸기
          
          # =======================================================
          # RNSScreen.h & RNSScreen.mm Robust Patch (v3)
          # =======================================================
          begin
            require 'fileutils'
            repo_root = File.expand_path('..', __dir__)
            rns_ios_dir = File.join(repo_root, 'node_modules', 'react-native-screens', 'ios')
            
            # ---------------------------------
            # 1. Patch RNSScreen.h (Declaration)
            # ---------------------------------
            rnsscreen_h_file = File.join(rns_ios_dir, 'RNSScreen.h')
            if File.exist?(rnsscreen_h_file)
              puts "🔍 Patching RNSScreen.h method declaration..."
              content_h = File.read(rnsscreen_h_file)
              original_content_h = content_h.dup
              
              # Check if already patched
              unless content_h.match(/#if\s+RCT_NEW_ARCH_ENABLED[\s\S]*?rnscreens_findTouchHandlerInAncestorChain/)
                # Find declaration and wrap it
                content_h.gsub!(
                  /(\s*)(\-\s*\(\s*RCTSurfaceTouchHandler\s*\*\s*\)\s*rnscreens_findTouchHandlerInAncestorChain;)/
                ) do
                  indent = $1
                  original_declaration = $2
                  legacy_declaration = original_declaration.gsub('RCTSurfaceTouchHandler', 'RCTTouchHandler')
                  
                  "\n#{indent}#if RCT_NEW_ARCH_ENABLED\n" +
                  "#{indent}#{original_declaration}\n" +
                  "#{indent}#else\n" +
                  "#{indent}#{legacy_declaration}\n" +
                  "#{indent}#endif"
                end

                if content_h != original_content_h
                  File.write(rnsscreen_h_file, content_h)
                  puts "  ✅ Patched method declaration in RNSScreen.h"
                else
                  puts "  ℹ️  No declaration changes needed for RNSScreen.h."
                end
              else
                puts "  ✅ RNSScreen.h declaration already patched."
              end
            else
              puts "⚠️ RNSScreen.h not found."
            end

            # ------------------------------------
            # 2. Patch RNSScreen.mm (Implementation)
            # ------------------------------------
            rnsscreen_mm_file = File.join(rns_ios_dir, 'RNSScreen.mm')
            if File.exist?(rnsscreen_mm_file)
              puts "🔍 Patching RNSScreen.mm implementation..."
              content_mm = File.read(rnsscreen_mm_file)
              original_content_mm = content_mm.dup

              # Patch 1: Method implementation declaration (if not already patched)
              unless content_mm.match(/#if\s+RCT_NEW_ARCH_ENABLED[\s\S]*?rnscreens_findTouchHandlerInAncestorChain\s*\{/)
                content_mm.gsub!(
                  /(\s*)(\-\s*\(\s*RCTSurfaceTouchHandler\s*\*\s*\)\s*rnscreens_findTouchHandlerInAncestorChain)\s*\{/
                ) do
                  indent = $1
                  original_declaration = $2
                  legacy_declaration = original_declaration.gsub('RCTSurfaceTouchHandler', 'RCTTouchHandler')

                  "\n#{indent}#if RCT_NEW_ARCH_ENABLED\n" +
                  "#{indent}#{original_declaration}\n" +
                  "#{indent}#else\n" +
                  "#{indent}#{legacy_declaration}\n" +
                  "#{indent}#endif\n" +
                  "#{indent}{"
                end
              end

              # Patch 2: The return statement (if not already patched)
              # This specifically targets `return _touchHandler;` inside the method.
              # A more robust regex looks for the method and the return inside it.
              unless content_mm.match(/rnscreens_findTouchHandlerInAncestorChain[\s\S]*?#if\s+RCT_NEW_ARCH_ENABLED[\s\S]*?return\s+\(RCTSurfaceTouchHandler/)
                 content_mm.gsub!(
                   /(rnscreens_findTouchHandlerInAncestorChain\s*\{(?:\s*#if\s!RCT_NEW_ARCH_ENABLED)?\s*)(return\s+_touchHandler;)/m
                 ) do
                   method_start = $1
                   "#{method_start}" +
                   "#if RCT_NEW_ARCH_ENABLED\n" +
                   "    return (RCTSurfaceTouchHandler *)_touchHandler;\n" +
                   "  #else\n" +
                   "    return (RCTTouchHandler *)_touchHandler;\n" +
                   "  #endif"
                 end
              end
              
              if content_mm != original_content_mm
                File.write(rnsscreen_mm_file, content_mm)
                puts "  ✅ Patched RNSScreen.mm implementation logic."
              else
                 puts "  ℹ️  No implementation changes needed for RNSScreen.mm."
              end
            end
          rescue => e
            Pod::UI.puts "⚠️ RNSScreen final patch failed: #{e.message}\n#{e.backtrace.first(3).join("\n")}"
          end
          
          # =======================================================
        else
          puts "⚠️ react-native-screens ios directory not found at expected path"
        end
      rescue => e
        Pod::UI.puts "⚠️ react-native-screens patch skipped: #{e.message}"
        Pod::UI.puts "   Stack trace: #{e.backtrace.first(3).join("\n   ")}"
      end
    end
  rescue => e
    Pod::UI.puts "⚠️ ExpoModulesCore Fabric files exclusion skipped: #{e.message}"
    Pod::UI.puts "   Stack trace: #{e.backtrace.first(3).join("\n   ")}"
  end

  # ============================================
  # 추가 예방 패치: react-native-reanimated
  # ============================================
  # react-native-reanimated도 New Architecture 조건부 컴파일에서
  # #ifdef를 사용할 수 있으므로 react-native-screens와 동일한 패치 적용
  begin
    node_modules_dir = File.join(__dir__, '..', 'node_modules')
    reanimated_ios_dir = File.join(node_modules_dir, 'react-native-reanimated', 'ios')
    if Dir.exist?(reanimated_ios_dir)
      puts "🔍 Applying preventive patches to react-native-reanimated..."
      
      # 모든 .mm, .m, .h 파일에서 #ifdef -> #if, #ifndef -> #if ! 변환
      Dir.glob(File.join(reanimated_ios_dir, '**', '*.{mm,m,h}')).each do |file_path|
        begin
          content = File.read(file_path)
          original_content = content.dup
          
          # #ifdef RCT_NEW_ARCH_ENABLED -> #if RCT_NEW_ARCH_ENABLED
          content.gsub!(/#ifdef\s+RCT_NEW_ARCH_ENABLED/, '#if RCT_NEW_ARCH_ENABLED')
          # #ifndef RCT_NEW_ARCH_ENABLED -> #if !RCT_NEW_ARCH_ENABLED
          content.gsub!(/#ifndef\s+RCT_NEW_ARCH_ENABLED/, '#if !RCT_NEW_ARCH_ENABLED')
          
          if content != original_content
            File.write(file_path, content)
            puts "  ✅ Patched: #{File.basename(file_path)}"
          end
        rescue => e
          # 개별 파일 패치 실패는 무시하고 계속 진행
          end
        end

      puts "✅ react-native-reanimated preventive patches applied"
    end
  rescue => e
    Pod::UI.puts "⚠️ react-native-reanimated preventive patch skipped: #{e.message}"
  end

  # ============================================
  # 추가 예방 패치: react-native-safe-area-context
  # ============================================
  begin
    safearea_ios_dir = File.join(node_modules_dir, 'react-native-safe-area-context', 'ios')
    if Dir.exist?(safearea_ios_dir)
      puts "🔍 Applying preventive patches to react-native-safe-area-context..."
      
      # 모든 .mm, .m, .h 파일에서 #ifdef -> #if, #ifndef -> #if ! 변환
      Dir.glob(File.join(safearea_ios_dir, '**', '*.{mm,m,h}')).each do |file_path|
        begin
          content = File.read(file_path)
          original_content = content.dup
          
          # #ifdef RCT_NEW_ARCH_ENABLED -> #if RCT_NEW_ARCH_ENABLED
          content.gsub!(/#ifdef\s+RCT_NEW_ARCH_ENABLED/, '#if RCT_NEW_ARCH_ENABLED')
          # #ifndef RCT_NEW_ARCH_ENABLED -> #if !RCT_NEW_ARCH_ENABLED
          content.gsub!(/#ifndef\s+RCT_NEW_ARCH_ENABLED/, '#if !RCT_NEW_ARCH_ENABLED')
          
          if content != original_content
            File.write(file_path, content)
            puts "  ✅ Patched: #{File.basename(file_path)}"
          end
        rescue => e
          # 개별 파일 패치 실패는 무시하고 계속 진행
    end
  end
    
      puts "✅ react-native-safe-area-context preventive patches applied"
    end
  rescue => e
    Pod::UI.puts "⚠️ react-native-safe-area-context preventive patch skipped: #{e.message}"
  end

  # ============================================
  # 추가 예방 패치: 기타 주요 라이브러리들
  # ============================================
  # react-native-gesture-handler, react-native-webview 등도 동일한 패턴 적용
  [
    'react-native-gesture-handler',
    'react-native-webview'
  ].each do |lib_name|
    begin
      lib_ios_dir = File.join(node_modules_dir, lib_name, 'ios')
      if Dir.exist?(lib_ios_dir)
        puts "🔍 Applying preventive patches to #{lib_name}..."
        
        changed_files = 0
        Dir.glob(File.join(lib_ios_dir, '**', '*.{mm,m,h}')).each do |file_path|
          begin
            content = File.read(file_path)
            original_content = content.dup
            
            # #ifdef RCT_NEW_ARCH_ENABLED -> #if RCT_NEW_ARCH_ENABLED
            content.gsub!(/#ifdef\s+RCT_NEW_ARCH_ENABLED/, '#if RCT_NEW_ARCH_ENABLED')
            # #ifndef RCT_NEW_ARCH_ENABLED -> #if !RCT_NEW_ARCH_ENABLED
            content.gsub!(/#ifndef\s+RCT_NEW_ARCH_ENABLED/, '#if !RCT_NEW_ARCH_ENABLED')
            
            if content != original_content
              File.write(file_path, content)
              changed_files += 1
            end
          rescue => e
            # 개별 파일 패치 실패는 무시하고 계속 진행
          end
        end
        
        if changed_files > 0
          puts "  ✅ Patched #{changed_files} file(s) in #{lib_name}"
        else
          puts "  ℹ️  No changes needed in #{lib_name}"
        end
      end
    rescue => e
      Pod::UI.puts "⚠️ #{lib_name} preventive patch skipped: #{e.message}"
    end
  end

  # =================================================================
  # FINAL PATCH for react-native-screens (New Arch / Legacy Arch)
  # =================================================================
  # patch-package 방식의 불안정성으로 인해 Podfile에서 직접 수정하는 방식으로 회귀.
  # 가장 단순하고 확실한 방식으로 필요한 파일만 찾아 수정.
  begin
    rns_path = Pathname.new(File.join(installer.pods_project.project_dir, '..', 'node_modules', 'react-native-screens'))
    rns_h_path = rns_path.join('ios', 'RNSScreen.h')
    rns_mm_path = rns_path.join('ios', 'RNSScreen.mm')

    if File.exist?(rns_h_path)
      Pod::UI.puts "✅ Patching RNSScreen.h"
      content = File.read(rns_h_path)
      content.gsub!('RCTSurfaceTouchHandler *', 'RCTTouchHandler *')
      File.write(rns_h_path, content)
    end

    if File.exist?(rns_mm_path)
      Pod::UI.puts "✅ Patching RNSScreen.mm"
      content = File.read(rns_mm_path)
      content.gsub!('RCTSurfaceTouchHandler *', 'RCTTouchHandler *')
      File.write(rns_mm_path, content)
    end
  rescue => e
    Pod::UI.warn "⚠️ Could not apply react-native-screens patch: #{e}"
  end

  installer.pods_project.save
end
