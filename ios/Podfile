require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/react-native/scripts/react_native_post_install'
require_relative '../node_modules/expo/scripts/autolinking'

platform :ios, '13.0'
project 'PickPlay.xcodeproj'

target 'PickPlay' do
  use_expo_modules!

  use_react_native!(
    :hermes_enabled => true,
    :fabric_enabled => false,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

end

post_install do |installer|
  react_native_post_install(installer)

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # -G 오류 제거 (Array/String 모두 안전 처리)
      flags = config.build_settings['OTHER_CFLAGS']
      if flags.is_a?(Array)
        config.build_settings['OTHER_CFLAGS'] = flags.reject { |f| f == '-G' }
      elsif flags.is_a?(String)
        cleaned = flags.split(' ').reject { |f| f == '-G' }
        config.build_settings['OTHER_CFLAGS'] = cleaned
      end

      # New Architecture 비활성화
      defs = (config.build_settings["GCC_PREPROCESSOR_DEFINITIONS"] ||= [])
      defs << "RCT_NEW_ARCH_ENABLED=0" unless defs.include?("RCT_NEW_ARCH_ENABLED=0")
    end
  end
end
