post_install do |installer|
  react_native_post_install(installer)
  Expo::PostInstall.install!(installer) if defined?(Expo::PostInstall)

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # 공통 설정 적용
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['SWIFT_VERSION'] = '5.0'
      config.build_settings['CODE_SIGN_STYLE'] = 'Automatic'
      config.build_settings.delete('PROVISIONING_PROFILE_SPECIFIER')
    end

    # ✅ BoringSSL-GRPC 완전 제거 로직
    if target.name == 'BoringSSL-GRPC'
      puts "🔍 Fixing: #{target.name}"

      flag_keys = %w[
        OTHER_CFLAGS OTHER_CPLUSPLUSFLAGS OTHER_LDFLAGS
        WARNING_CFLAGS GCC_PREPROCESSOR_DEFINITIONS
      ]

      target.build_configurations.each do |config|
        flag_keys.each do |key|
          val = config.build_settings[key]
          next unless val
          cleaned =
            if val.is_a?(String)
              val.gsub(/\s-G(\s|$)/, ' ').squeeze(' ').strip
            elsif val.is_a?(Array)
              val.map { |v| v.gsub(/\s-G(\s|$)/, ' ').strip }.reject(&:empty?)
            end

          config.build_settings[key] = cleaned
        end
      end

      # ✅ 개별 소스 파일 컴파일러 플래그 제거
      g_pattern = /(^|\s)-G(?=\s|$)/

      target.build_phases.grep(Xcodeproj::Project::Object::PBXSourcesBuildPhase).each do |phase|
        phase.files.each do |bf|
          next unless bf.settings
          next unless bf.settings['COMPILER_FLAGS']

          flagged = bf.settings['COMPILER_FLAGS']
          cleaned =
            if flagged.is_a?(String)
              flagged.gsub(g_pattern, ' ').squeeze(' ').strip
            elsif flagged.is_a?(Array)
              flagged.map { |s| s.gsub(g_pattern, ' ').strip }.reject(&:empty?)
            end

          bf.settings['COMPILER_FLAGS'] = cleaned.empty? ? nil : cleaned
        end
      end

      puts "✅ All -G flags removed for #{target.name}"
    end
  end
end
