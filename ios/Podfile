platform :ios, '15.1'
ENV['RCT_NEW_ARCH_ENABLED'] ||= '0'

install! 'cocoapods', :disable_input_output_paths => true

# ✅ RN autolinking
begin
  require_relative '../node_modules/@react-native-community/cli-platform-ios/native_modules'
rescue LoadError
  begin
    require_relative '../node_modules/@react-native/cli-platform-ios/native_modules'
  rescue LoadError
    Pod::UI.puts '⚠️ RN autolinking not found'
    def use_native_modules!(*args); end
  end
end

# ✅ React Native main pod config
require_relative '../node_modules/react-native/scripts/react_native_pods'
prepare_react_native_project!

# ✅ Expo autolinking
begin
  require_relative '../node_modules/expo-modules-autolinking/scripts/autolinking'
rescue LoadError
  Pod::UI.puts '⚠️ Expo autolinking not found'
  def use_expo_modules!(*args); end
  module Expo; module PostInstall
    def self.install!(*args); end
  end; end
end

use_frameworks! :linkage => :static
$RNReanimated = { :codegen_disabled => true }

# ✅ Dynamic project detection
xcodeproj_path = Dir.glob(File.join(__dir__, '*.xcodeproj')).first
if xcodeproj_path.nil?
  Pod::UI.puts "❌ No .xcodeproj found"
  raise
end

xcodeproj_name = File.basename(xcodeproj_path)
target_name = File.basename(xcodeproj_path, '.xcodeproj')

project xcodeproj_name

target target_name do
  use_expo_modules!

  config = use_native_modules!

  use_react_native!(
    :path => (config && config[:reactNativePath]) || '../node_modules/react-native',
    :hermes_enabled => true,
    :fabric_enabled => false,
    :app_path => ".."
  )

  firebase_version = '10.25.0'
  pod 'FirebaseCore', firebase_version
  pod 'FirebaseAuth', firebase_version
  pod 'FirebaseFirestore', firebase_version
  pod 'FirebaseFunctions', firebase_version
end

post_install do |installer|
  react_native_post_install(installer)
  Expo::PostInstall.install!(installer) if defined?(Expo::PostInstall)

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['SWIFT_VERSION'] = '5.0'
      config.build_settings['CODE_SIGN_STYLE'] = 'Automatic'
      config.build_settings.delete('PROVISIONING_PROFILE_SPECIFIER')

      name = target.name.to_s

      # ✅ Firebase 모듈 안정성 향상
      if name.include?('Google') || name.include?('Firebase')
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end

      # ✅ BoringSSL-GRPC -G 제거 (근본적 해결)
      if name == 'BoringSSL-GRPC'
        flag_keys = [
          'OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS', 'OTHER_LDFLAGS'
        ]
        
        flag_keys.each do |key|
          v = config.build_settings[key]
          next unless v
          cleaned = if v.is_a?(String)
            v.gsub(/\s-G(\s|$)/, ' ').strip
          elsif v.is_a?(Array)
            v.map { |x| x.gsub(/\s-G(\s|$)/, ' ') }.reject(&:empty?)
          end
          config.build_settings[key] = cleaned
        end
        puts "✅ [-G removed] #{name}"
      end
    end
  end
end

