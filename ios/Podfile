platform :ios, '15.1'
ENV['RCT_NEW_ARCH_ENABLED'] ||= '0'

install! 'cocoapods', :disable_input_output_paths => true

# ✅ RN iOS autolinking
begin
  require_relative '../node_modules/@react-native-community/cli-platform-ios/native_modules'
rescue LoadError
  begin
    require_relative '../node_modules/@react-native/cli-platform-ios/native_modules'
  rescue LoadError
    Pod::UI.puts '⚠️  RN iOS autolinking script not found; continuing without it'
    def use_native_modules!(*args); end
  end
end

require_relative '../node_modules/react-native/scripts/react_native_pods'
prepare_react_native_project!  

# ✅ Expo autolinking
begin
  require_relative '../node_modules/expo-modules-autolinking/scripts/autolinking'
rescue LoadError
  begin
    require_relative '../node_modules/expo-modules-autolinking/build/scripts/autolinking'
  rescue LoadError
    Pod::UI.puts '⚠️  expo-modules-autolinking not found; continuing without it'
    def use_expo_modules!(*args); end
    module Expo; module PostInstall; def self.install!(*args); end; end; end
  end
end

use_frameworks! :linkage => :static
$RNReanimated = { :codegen_disabled => true }

# ✅ 자동으로 Xcodeproj 찾기
xcodeproj_path = Dir.glob(File.join(__dir__, '*.xcodeproj')).first
raise "Missing Xcode project" if xcodeproj_path.nil?

xcodeproj_name = File.basename(xcodeproj_path)
target_name = File.basename(xcodeproj_path, '.xcodeproj')
project xcodeproj_name

target target_name do
  use_expo_modules!
  config = use_native_modules!

  use_react_native!(
    :path => (config && config[:reactNativePath]) || '../node_modules/react-native',
    :hermes_enabled => true,
    :fabric_enabled => false,
    :app_path => ".."
  )

end

post_install do |installer|
  puts "🔧 [post_install] Custom Podfile post_install hook executing..."
  react_native_post_install(installer)
  Expo::PostInstall.install!(installer)

  # ✅ -G 문제 재발 방지
  begin
    openssl_t = installer.pods_project.targets.find { |t| t.name == 'BoringSSL-GRPC-openssl_grpc' }
    if openssl_t
      openssl_t.remove_from_project
      puts "🔥 Removed target: BoringSSL-GRPC-openssl_grpc"
    end
  rescue => e
    puts "⚠️ Failed to remove openssl_grpc target: #{e.message}"
  end

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      name = target.name.to_s

      # ✅ 최소 iOS 15.1 유지
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
      config.build_settings['ENABLE_BITCODE'] = 'NO'

      # ✅ 모든 Pods 자동 코드사인 방지
      config.build_settings['CODE_SIGN_STYLE'] = 'Automatic'
      config.build_settings.delete('PROVISIONING_PROFILE_SPECIFIER')

      # ✅ GRPC 대상 -G 제거
      if ['BoringSSL-GRPC', 'BoringSSL-GRPC-openssl_grpc'].include?(name)

        flag_keys = %w[
          OTHER_CFLAGS OTHER_CPLUSPLUSFLAGS OTHER_LDFLAGS
          WARNING_CFLAGS GCC_PREPROCESSOR_DEFINITIONS
          OTHER_CFLAGS[arch=arm64] OTHER_CPLUSPLUSFLAGS[arch=arm64] OTHER_LDFLAGS[arch=arm64]
          OTHER_CFLAGS[sdk=iphoneos*] OTHER_CPLUSPLUSFLAGS[sdk=iphoneos*] OTHER_LDFLAGS[sdk=iphoneos*]
          OTHER_CFLAGS[sdk=iphonesimulator*] OTHER_CPLUSPLUSFLAGS[sdk=iphonesimulator*] OTHER_LDFLAGS[sdk=iphonesimulator*]
        ]

        flag_keys.each do |key|
          v = config.build_settings[key]
          next unless v
          if v.is_a?(String)
            cleaned = v.gsub(/\s-G(\s|$)/, ' ').squeeze(' ').strip
            config.build_settings[key] = cleaned.empty? ? '$(inherited)' : cleaned
          elsif v.is_a?(Array)
            cleaned = v.map { |s| s.gsub(/\s-G(\s|$)/, ' ').squeeze(' ').strip }.reject(&:empty?)
            config.build_settings[key] = cleaned.empty? ? ['$(inherited)'] : cleaned
          end
        end

        g_pattern = /(^|\s)-G(?=\s|$)/
        target.build_phases.grep(Xcodeproj::Project::Object::PBXSourcesBuildPhase).each do |phase|
          phase.files.each do |bf|
            next unless bf.settings && bf.settings['COMPILER_FLAGS']
            flags = bf.settings['COMPILER_FLAGS']
            if flags.is_a?(String)
              cleaned = flags.gsub(g_pattern, ' ').squeeze(' ').strip
              bf.settings['COMPILER_FLAGS'] = cleaned.empty? ? nil : cleaned
            elsif flags.is_a?(Array)
              cleaned = flags.map { |s| s.gsub(g_pattern, ' ').squeeze(' ').strip }.reject(&:empty?)
              bf.settings['COMPILER_FLAGS'] = cleaned.empty? ? nil : cleaned
            end
