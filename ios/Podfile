source 'https://cdn.cocoapods.org/'
require_relative '../node_modules/react-native/scripts/react_native_pods'

begin
  require_relative '../node_modules/react-native/scripts/react_native_post_install'
rescue LoadError
  Pod::UI.puts '⚠️  react_native_post_install not found; continuing without it'
  def react_native_post_install(*); end
end

  begin
  require_relative '../node_modules/expo/scripts/autolinking'
  rescue LoadError
  Pod::UI.puts '⚠️  expo autolinking script not found; continuing without it'
  def use_expo_modules!(*); end
end

platform :ios, '15.1'
project 'PickPlay.xcodeproj'

target 'PickPlay' do
  use_expo_modules!

  # New Architecture 명시적으로 비활성화
  ENV['RCT_NEW_ARCH_ENABLED'] = '0'

  use_react_native!(
    :hermes_enabled => true,
    :fabric_enabled => false,
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    
    # --- Folly, C++ 표준, 신 아키텍처 비활성화 관련 모든 설정을 이곳에 통합 ---
    # 이것이 가장 확실하고 우선순위가 높은 유일한 방법입니다.
    :user_target_xcconfig => {
      # 1. C++ 컴파일러가 Folly 헤더를 찾도록 USER_HEADER_SEARCH_PATHS 에 경로 추가 (핵심 수정)
      'USER_HEADER_SEARCH_PATHS' => '"$(PODS_ROOT)/boost" "$(PODS_ROOT)/RCT-Folly"',
      
      # 2. FOLLY_NO_CONFIG 매크로 정의
      'GCC_PREPROCESSOR_DEFINITIONS' => '$(inherited) FOLLY_NO_CONFIG=1 RCT_NEW_ARCH_ENABLED=0',
      
      # 3. C++ 표준 강제
      'CLANG_CXX_LANGUAGE_STANDARD' => 'gnu++20',
    },
    :pod_target_xcconfig => {
      'USER_HEADER_SEARCH_PATHS' => '"$(PODS_ROOT)/boost" "$(PODS_ROOT)/RCT-Folly"',
      'GCC_PREPROCESSOR_DEFINITIONS' => '$(inherited) FOLLY_NO_CONFIG=1 RCT_NEW_ARCH_ENABLED=0',
      'CLANG_CXX_LANGUAGE_STANDARD' => 'gnu++20',
    }
  )

  # Fallback: Ensure RNScreens is resolvable for Expo pods (e.g., ExpoHead)
  if File.exist?(File.join(__dir__, '../node_modules/react-native-screens/RNScreens.podspec'))
    pod 'RNScreens', :path => '../node_modules/react-native-screens'
  end

end

# post_install 스크립트에서 중복 값 없이 배열에 요소를 추가하기 위한 헬퍼 메소드
class Array
  def unshift_unless_exist(value)
    self.unshift(value) unless self.include?(value)
  end
end

post_install do |installer|
  begin
    react_native_post_install(installer)
  rescue => e
    Pod::UI.puts "⚠️  react_native_post_install failed: #{e.message}"
  end
  
  # ExpoModulesCore Swift 파일들의 import React를 환경별로 안전하게 처리
  begin
    repo_root = File.expand_path('..', __dir__)
    expo_ios_dir = File.join(repo_root, 'node_modules', 'expo-modules-core', 'ios')
    if Dir.exist?(expo_ios_dir)
      Dir.glob(File.join(expo_ios_dir, '**', '*.swift')).each do |swift_file|
        begin
          content = File.read(swift_file)
          original_content = content.dup
          
          # 'import React' 패치
          if content.include?('import React') && !content.include?('#if canImport(React)')
            content.gsub!(/^\s*import\s+React\s*$/, <<~SWIFT.chomp
              #if canImport(React)
              import React
              #elseif canImport(React_Core)
              import React_Core
              #endif
            SWIFT
            )
          end

          if content != original_content
            File.write(swift_file, content)
            puts "✅ Patched React import in #{swift_file.sub(repo_root + '/', '')}"
          end
        rescue => e
          Pod::UI.puts "⚠️ Failed to patch module import in #{swift_file}: #{e.message}"
        end
      end
    end
  rescue => e
    Pod::UI.puts "⚠️ ExpoModulesCore module import patch skipped: #{e.message}"
  end

  # Hermes 스크립트 단계가 CI에서 실패하는 이슈 방지: 스크립트를 no-op 처리
  begin
    hermes_target = installer.pods_project.targets.find { |t| t.name == 'hermes-engine' }
    if hermes_target
      hermes_target.build_phases.grep(Xcodeproj::Project::Object::PBXShellScriptBuildPhase).each do |bp|
        next unless bp.name.to_s.include?('Replace Hermes for the right configuration')
        bp.shell_script = "echo \"[CI] Skipping Hermes replacement script (no-op).\""
        puts "🛠️  Hermes replacement script converted to no-op for CI stability."
      end
    end
  rescue => e
    Pod::UI.puts "⚠️ Hermes script phase tweak skipped: #{e.message}"
  end

  # [RN]Check rncore 스크립트 비활성화 (New Architecture 비활성화 상태에서 Codegen 체크 불필요)
  begin
    ['React-Fabric', 'React-FabricComponents'].each do |target_name|
      target = installer.pods_project.targets.find { |t| t.name == target_name }
      next unless target

      target.build_phases.grep(Xcodeproj::Project::Object::PBXShellScriptBuildPhase).each do |bp|
        next unless bp.name.to_s.include?('[RN]Check rncore')
        bp.shell_script = "echo \"[CI] Skipping [RN]Check rncore script (newArchEnabled=false).\""
        puts "🛠️  [RN]Check rncore script in #{target_name} converted to no-op."
      end
    end
  rescue => e
    Pod::UI.puts "⚠️ [RN]Check rncore script tweak skipped: #{e.message}"
  end

end
    
