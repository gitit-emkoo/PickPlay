platform :ios, '13.4'

require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/@react-native-firebase/app/RNFBPodHelper'
require_relative '../node_modules/@react-native-community/cli-platform-ios/native_modules'

use_frameworks! :linkage => :static

target 'PickPlay' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :fabric_enabled => true,
    :flipper_configuration => FlipperConfiguration.disabled,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    puts "🔧 [post_install] Custom config active"
    
    # Safe-guard: pods_project 존재 확인
    if installer.pods_project.nil?
      puts "⚠️  [post_install] pods_project not found! Skipping custom config"
      return
    end
    
    puts "✅ [post_install] pods_project found, applying build settings..."
    
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    installer.pods_project.targets.each do |target|
      name = target.name.to_s

      target.build_configurations.each do |config|
        # RNFB*, React, RCT 계열에 비-모듈러 헤더 허용 + 모듈 정의 강제
        if name.start_with?('RNFB', 'React', 'RCT')
          # 핵심: non-modular include 허용 & 경고 off
          config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
          config.build_settings['CLANG_WARN_NON_MODULAR_INCLUDE_IN_FRAMEWORK_MODULE'] = 'NO'
          config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'

          # 모듈 사용 강제
          config.build_settings['DEFINES_MODULE'] = 'YES'
          config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'

          # 혹시라도 경고가 에러로 승격될 경우 방지
          other_cflags = config.build_settings['OTHER_CFLAGS'] || ['$(inherited)']
          unless other_cflags.include?('-Wno-error=non-modular-include-in-framework-module')
            other_cflags << '-Wno-error=non-modular-include-in-framework-module'
          end
          config.build_settings['OTHER_CFLAGS'] = other_cflags

          puts "⚙️ Applied non-modular allow to #{name} (#{config.name})"
        end

        # gRPC/Protobuf 등 일부 타깃은 모듈러 헤더 미지원
        if name.include?('gRPC') || name.include?('grpc') || name.include?('BoringSSL') || name.include?('Protobuf')
          config.build_settings['DEFINES_MODULE'] = 'NO'
          config.build_settings['CLANG_ENABLE_MODULES'] = 'NO'
          puts "⚙️ Disabled modules for #{name}"
        end

        # iOS 13.4+ deployment target 강제
        config.build_settings.delete 'IPHONEOS_DEPLOYMENT_TARGET'
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.4'
      end
    end
  end
end

