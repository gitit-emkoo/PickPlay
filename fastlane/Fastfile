# frozen_string_literal: true
require "base64"

default_platform(:ios)

# --- 프로젝트 경로/상수 (SSoT) ---
REPO_ROOT   = File.expand_path('..', __dir__)             # Fastfile 기준 상위가 리포 루트
IOS_DIR     = File.join(REPO_ROOT, "ios")
XCODEPROJ   = File.join(IOS_DIR,  "PickPlay.xcodeproj")
WORKSPACE   = File.join(IOS_DIR,  "PickPlay.xcworkspace")
SCHEME      = "PickPlay"                                   # Xcode 스킴명
BUNDLE_ID   = "com.pickplay.kwcc"
ENTITLEMENTS_PATH = File.join(IOS_DIR, "PickPlay", "PickPlay.entitlements")

TEAM_ID     = ENV["APPLE_TEAM_ID"]                        # GitHub Secrets
KEYCHAIN_PW = ENV.fetch("KEYCHAIN_PASSWORD", "actions")

def asc_api_key!
  app_store_connect_api_key(
    key_id:       ENV["APP_STORE_CONNECT_API_KEY_ID"],
    issuer_id:    ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
    key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
    duration:     1200,
    in_house:     false
  )
end

def prepare_ci!
  opt_out_usage
  setup_ci
  ensure_xcode_version(version: "16.2")

  create_keychain(
    name: "build",
    password: KEYCHAIN_PW,
    default_keychain: true,
    unlock: true,
    timeout: 3600,
    add_to_search_list: true
  )
end

def ensure_push_entitlement!
  unless File.exist?(ENTITLEMENTS_PATH)
    UI.important("⚠️ Entitlements 파일이 없습니다: #{ENTITLEMENTS_PATH}. Xcode에서 추가하세요.")
    return
  end
  content = File.read(ENTITLEMENTS_PATH) rescue ""
  unless content.include?("<key>aps-environment</key>")
    UI.user_error!("❌ Entitlements에 aps-environment가 없습니다. Push 빌드는 실패합니다: #{ENTITLEMENTS_PATH}")
  end
end

def cocoapods_install!
  sh("cd #{IOS_DIR} && pod install --repo-update")
end

def update_sign_team!
  update_project_team(path: XCODEPROJ, teamid: TEAM_ID)
end

def build_with_profile!(pp_uuid)
  # 아카이브
  build_app(
    workspace:     WORKSPACE,
    scheme:        SCHEME,
    configuration: "Release",
    export_method: "app-store",
    clean:         true,
    skip_codesigning: false,
    xcargs: [
      "DEVELOPMENT_TEAM=#{TEAM_ID}",
      "CODE_SIGN_STYLE=Manual",
      "PRODUCT_BUNDLE_IDENTIFIER=#{BUNDLE_ID}",
      # UUID를 명시해 구(舊) 프로파일 캐시를 무력화
      "PROVISIONING_PROFILE_SPECIFIER=#{pp_uuid}",
      "SWIFT_OPTIMIZATION_LEVEL=-O"
    ].join(" ")
    # export_options 생략: Xcode가 아카이브 내 서명정보 사용
  )
end

platform :ios do
  desc "(1회용) 푸시 포함 App Store 프로비저닝 프로파일 재생성"
  lane :bootstrap_profiles do
    prepare_ci!
    api_key = asc_api_key!

    # App ID에 Push가 켜져 있어야 함(포털에서 ON 확인)
    ensure_push_entitlement!

    # 새 인증서/프로파일 강제 생성 (푸시 포함)
    match(
      type: "appstore",
      readonly: false,              # ✅ 재생성
      force: true,                  # ✅ 항상 새로
      app_identifier: BUNDLE_ID,
      team_id: TEAM_ID,
      api_key: api_key,
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: Base64.strict_encode64("#{ENV['MATCH_GIT_USERNAME']}:#{ENV['MATCH_GIT_PASSWORD']}"),
      keychain_name: "build",
      keychain_password: KEYCHAIN_PW
    )

    # 내려받은 최신 프로파일 UUID
    pp_uuid = lane_context[SharedValues::SIGH_UDID]
    UI.message("📋 New provisioning profile UUID: #{pp_uuid}")

    cocoapods_install!
    increment_build_number(xcodeproj: XCODEPROJ)
    update_sign_team!

    build_with_profile!(pp_uuid)

    UI.success("✅ bootstrap_profiles 완료 — 이후부터는 :beta 사용")
  end

  desc "TestFlight 배포 (일상 빌드: readonly)"
  lane :beta do
    prepare_ci!
    api_key = asc_api_key!
    ensure_push_entitlement!

    # 기존(최신) 인증서/프로파일만 동기화
    match(
      type: "appstore",
      readonly: true,
      app_identifier: BUNDLE_ID,
      team_id: TEAM_ID,
      api_key: api_key,
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: Base64.strict_encode64("#{ENV['MATCH_GIT_USERNAME']}:#{ENV['MATCH_GIT_PASSWORD']}"),
      keychain_name: "build",
      keychain_password: KEYCHAIN_PW
    )

    # match가 설정한 UUID 우선 사용, 없으면 포털에서 조회
    pp_uuid = lane_context[SharedValues::SIGH_UDID]
    if pp_uuid.to_s.strip.empty?
      UI.message("ℹ️ match 컨텍스트에 UUID가 없어 포털에서 조회합니다(get_provisioning_profile)")
      pp_path = get_provisioning_profile(
        app_identifier: BUNDLE_ID,
        type: "appstore",
        api_key: api_key,
        readonly: true
      )
      pp_uuid = lane_context[SharedValues::SIGH_UDID]
      UI.message("📋 Resolved provisioning profile UUID: #{pp_uuid}")
      UI.message("📄 Path: #{pp_path}")
    end

    cocoapods_install!
    increment_build_number(xcodeproj: XCODEPROJ)
    update_sign_team!

    build_with_profile!(pp_uuid)

    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )

    # (옵션) Firebase App Distribution
    if ENV["FIREBASE_TOKEN"].to_s.strip != "" && ENV["FIREBASE_APP_ID"].to_s.strip != ""
      begin
        firebase_app_distribution(
          app: ENV["FIREBASE_APP_ID"],
          groups: "testers",
          release_notes: "Automated build from GitHub Actions"
        )
        UI.success("✅ Firebase App Distribution 업로드 완료")
      rescue => e
        UI.important("⚠️ Firebase App Distribution 실패: #{e.message}")
      end
    end

    UI.success("✅ TestFlight 업로드 성공")
  end
end
