# frozen_string_literal: true
require "base64"

default_platform(:ios)

# --- 프로젝트 경로/상수 ---
REPO_ROOT   = File.expand_path('..', __dir__)       # Fastfile 기준 상위가 리포 루트
IOS_DIR     = File.join(REPO_ROOT, "ios")
XCODEPROJ   = File.join(IOS_DIR,  "PickPlay.xcodeproj")
WORKSPACE   = File.join(IOS_DIR,  "PickPlay.xcworkspace")
SCHEME      = "PickPlay"                             # Xcode 스킴명과 동일해야 함
BUNDLE_ID   = "com.pickplay.kwcc"

TEAM_ID     = ENV["APPLE_TEAM_ID"]                  # GitHub Secrets에서 주입됨
KEYCHAIN_PW = ENV.fetch("KEYCHAIN_PASSWORD", "actions")

# --- 공통 CI 준비: ensure_xcode_version 제거 버전 ---
def prepare_ci!
  opt_out_usage
  setup_ci

  # 이미 GHA에서 Xcode 16.2를 선택했음. fastlane의 ensure_xcode_version을 쓰지 않고 경로 고정/로그만 남김.
  sh("xcodebuild -version | tee /dev/stderr")
  xcode_select("/Applications/Xcode_16.2.app")

  create_keychain(
    name: "build",
    password: KEYCHAIN_PW,
    default_keychain: true,
    unlock: true,
    timeout: 3600,
    add_to_search_list: true
  )
end

platform :ios do
  desc "One-time: Push 포함 App Store 프로비저닝 생성/갱신"
  lane :bootstrap_profiles do
    prepare_ci!

    api_key = app_store_connect_api_key(
      key_id:       ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:    ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      duration:     1200,
      in_house:     false
    )

    # 최초 1회만 readonly: false로 실행 → Push 포함된 App Store 프로파일 생성/갱신
    match(
      type: "appstore",
      readonly: false,
      app_identifier: BUNDLE_ID,
      team_id: TEAM_ID,
      api_key: api_key,
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: Base64.strict_encode64("#{ENV['MATCH_GIT_USERNAME']}:#{ENV['MATCH_GIT_PASSWORD']}"),
      keychain_name: "build",
      keychain_password: KEYCHAIN_PW
    )
  end

  desc "TestFlight 배포 (Push 포함 프로비저닝 사용)"
  lane :beta do
    prepare_ci!

    api_key = app_store_connect_api_key(
      key_id:       ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:    ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      duration:     1200,
      in_house:     false
    )

    # 일상 배포: readonly=true (이미 생성된 프로파일을 사용)
    match(
      type: "appstore",
      readonly: true,
      app_identifier: BUNDLE_ID,
      team_id: TEAM_ID,
      api_key: api_key,
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: Base64.strict_encode64("#{ENV['MATCH_GIT_USERNAME']}:#{ENV['MATCH_GIT_PASSWORD']}"),
      keychain_name: "build",
      keychain_password: KEYCHAIN_PW
    )

    # match가 내려준 프로파일 UUID/경로
    pp_uuid = lane_context[SharedValues::SIGH_UDID]
    pp_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    UI.message("📋 Using provisioning profile UUID: #{pp_uuid}")
    UI.message("📋 Profile path: #{pp_path}")

    # Pods 재설치 (post_install 설정 적용)
    sh("cd #{IOS_DIR} && pod install")

    # (선택) 빌드 번호 자동 증가
    increment_build_number(xcodeproj: XCODEPROJ)

    # Team ID 주입 (타겟 자동서명 사용 안 함)
    update_project_team(
      path: XCODEPROJ,
      teamid: TEAM_ID
    )

    # 🚀 아카이브 (UUID로 서명 강제)
    build_app(
      workspace:     WORKSPACE,
      scheme:        SCHEME,
      configuration: "Release",
      export_method: "app-store",
      clean:         true,
      skip_codesigning: false,
      xcargs: "DEVELOPMENT_TEAM=#{TEAM_ID} " \
              "CODE_SIGN_STYLE=Manual " \
              "PRODUCT_BUNDLE_IDENTIFIER=#{BUNDLE_ID} " \
              "PROVISIONING_PROFILE_SPECIFIER=#{pp_uuid} " \
              "SWIFT_OPTIMIZATION_LEVEL=-O"
      # export_options 생략: 아카이브에 임베드된 UUID 기준으로 export
    )

    # TestFlight 업로드
    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )

    # (옵션) Firebase App Distribution
    if ENV["FIREBASE_TOKEN"].to_s.strip != "" && ENV["FIREBASE_APP_ID"].to_s.strip != ""
      begin
        firebase_app_distribution(
          app: ENV["FIREBASE_APP_ID"],
          groups: "testers",
          release_notes: "Automated build from GitHub Actions"
        )
        UI.success("✅ Firebase App Distribution 업로드 완료")
      rescue => e
        UI.important("⚠️ Firebase App Distribution 실패: #{e.message}")
      end
    end

    UI.success("✅ TestFlight 업로드 성공")
  end
end
