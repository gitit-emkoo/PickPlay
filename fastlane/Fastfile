# frozen_string_literal: true
require "base64"

default_platform(:ios)

# --- 프로젝트 경로/상수 ---
REPO_ROOT   = File.expand_path('..', __dir__)       # Fastfile 기준 상위가 리포 루트
IOS_DIR     = File.join(REPO_ROOT, "ios")
XCODEPROJ   = File.join(IOS_DIR,  "PickPlay.xcodeproj")
WORKSPACE   = File.join(IOS_DIR,  "PickPlay.xcworkspace")
SCHEME      = "PickPlay"                             # Xcode 스킴명과 동일해야 함
BUNDLE_ID   = "com.pickplay.kwcc"

TEAM_ID     = ENV["APPLE_TEAM_ID"]                  # GitHub Secrets에서 주입됨
KEYCHAIN_PW = ENV.fetch("KEYCHAIN_PASSWORD", "actions")

# --- 공통 CI 준비 ---
def prepare_ci!
  opt_out_usage
  setup_ci

  # Runner에서 Xcode는 워크플로우에서 선택되므로 여기선 버전 로깅만 수행
  sh("xcodebuild -version | tee /dev/stderr")
  xcode_select("/Applications/Xcode_16.2.app")

  create_keychain(
    name: "build",
    password: KEYCHAIN_PW,
    default_keychain: true,
    unlock: true,
    timeout: 3600,
    add_to_search_list: true
  )
end

def decode_profile_name(profile_path)
  # 모바일프로비전 파일에서 Name 값을 추출하여 SPECIFIER로 사용
  return "" if profile_path.to_s.strip.empty?
  begin
    sh %(
      /usr/bin/security cms -D -i "#{profile_path}" > /tmp/profile.plist &&
      /usr/libexec/PlistBuddy -c "Print :Name" /tmp/profile.plist
    )
  rescue
    ""
  end
end

def extract_profile_uuid(profile_path)
  # 모바일프로비전 파일에서 UUID 값을 추출
  return "" if profile_path.to_s.strip.empty?
  begin
    result = sh %(
      /usr/bin/security cms -D -i "#{profile_path}" > /tmp/profile.plist &&
      /usr/libexec/PlistBuddy -c "Print :UUID" /tmp/profile.plist 2>/dev/null
    ), log: false
    result.to_s.strip
  rescue
    ""
  end
end

def assert_push_in_profile!(profile_path)
  # 푸시 권한 포함 여부 로그 출력(aps-environment)
  return if profile_path.to_s.strip.empty?
  sh %(
    /usr/bin/security cms -D -i "#{profile_path}" > /tmp/profile.plist &&
    echo "➡️  Entitlements.aps-environment in profile:" &&
    /usr/libexec/PlistBuddy -c "Print :Entitlements:aps-environment" /tmp/profile.plist
  )
end

platform :ios do
  desc "ONE-TIME: Push 포함 App Store 프로파일 강제(renew) 생성"
  lane :bootstrap_profiles do
    prepare_ci!

    api_key = app_store_connect_api_key(
      key_id:       ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:    ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      duration:     1200,
      in_house:     false
    )

    # force + readonly:false 로 새 프로파일 생성/갱신 (Push 포함)
    match(
      type: "appstore",
      readonly: false,
      force: true,
      app_identifier: BUNDLE_ID,
      team_id: TEAM_ID,
      api_key: api_key,
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: Base64.strict_encode64("#{ENV['MATCH_GIT_USERNAME']}:#{ENV['MATCH_GIT_PASSWORD']}"),
      keychain_name: "build",
      keychain_password: KEYCHAIN_PW
    )

    pp_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    assert_push_in_profile!(pp_path)
  end

  desc "TestFlight 배포 (푸시 포함 프로파일 사용 강제)"
  lane :beta do
    prepare_ci!

    api_key = app_store_connect_api_key(
      key_id:       ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:    ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      duration:     1200,
      in_house:     false
    )

    # 일상 배포는 readonly=true (이미 생성된 프로파일 사용)
    match(
      type: "appstore",
      readonly: true,
      app_identifier: BUNDLE_ID,
      team_id: TEAM_ID,
      api_key: api_key,
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: Base64.strict_encode64("#{ENV['MATCH_GIT_USERNAME']}:#{ENV['MATCH_GIT_PASSWORD']}"),
      keychain_name: "build",
      keychain_password: KEYCHAIN_PW
    )

    # 프로파일 정보 (UUID/Name 모두 사용, 비어있으면 안전 폴백)
    pp_uuid = (lane_context[SharedValues::SIGH_UDID] || "").to_s.strip
    pp_path = (lane_context[SharedValues::SIGH_PROFILE_PATH] || "").to_s.strip
    
    # UUID가 없으면 프로파일 파일에서 직접 추출
    if pp_uuid.empty? && !pp_path.empty?
      pp_uuid = extract_profile_uuid(pp_path)
    end
    
    mapping = (lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] || {})
    mapped_name = (mapping[BUNDLE_ID] || "").to_s.strip  # e.g. "match AppStore com.pickplay.kwcc"
    decoded_name = decode_profile_name(pp_path).strip
    pp_name = !mapped_name.empty? ? mapped_name : decoded_name
    UI.message("📋 Using provisioning profile UUID: #{pp_uuid}")
    UI.message("📋 Using provisioning profile Name: #{pp_name}")
    assert_push_in_profile!(pp_path)

    # Pods 재설치 (post_install 설정 적용)
    sh("cd #{IOS_DIR} && pod install")

    # (선택) 빌드 번호 자동 증가
    increment_build_number(xcodeproj: XCODEPROJ)

    # Team ID 주입 (타겟 자동서명 사용 안 함)
    update_project_team(
      path: XCODEPROJ,
      teamid: TEAM_ID
    )

    # 🚀 아카이브 — specifier는 반드시 UUID로 고정 (공백 파싱 문제 방지)
    if pp_uuid.empty? || pp_uuid.length != 36
      UI.user_error!("유효한 프로비저닝 프로파일 UUID를 찾지 못했습니다. match 결과를 확인하세요.")
    end
    specifier = pp_uuid
    UI.message("📋 Using provisioning profile specifier: #{specifier}")
    
    build_app(
      workspace:     WORKSPACE,
      scheme:        SCHEME,
      configuration: "Release",
      export_method: "app-store",
      clean:         true,
      skip_codesigning: false,
      xcargs: [
        "DEVELOPMENT_TEAM=#{TEAM_ID}",
        "CODE_SIGN_STYLE=Manual",
        "PRODUCT_BUNDLE_IDENTIFIER=#{BUNDLE_ID}",
        "PROVISIONING_PROFILE_SPECIFIER=#{specifier}",
        "SWIFT_OPTIMIZATION_LEVEL=-O"
      ].compact.join(" "),
      export_options: {
        provisioningProfiles: {
          BUNDLE_ID => (pp_name.to_s.strip.empty? ? specifier : pp_name)
        }
      }
    )

    # TestFlight 업로드
    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )

    # (옵션) Firebase App Distribution
    if ENV["FIREBASE_TOKEN"].to_s.strip != "" && ENV["FIREBASE_APP_ID"].to_s.strip != ""
      begin
        firebase_app_distribution(
          app: ENV["FIREBASE_APP_ID"],
          groups: "testers",
          release_notes: "Automated build from GitHub Actions"
        )
        UI.success("✅ Firebase App Distribution 업로드 완료")
      rescue => e
        UI.important("⚠️ Firebase App Distribution 실패: #{e.message}")
      end
    end

    UI.success("✅ TestFlight 업로드 성공")
  end
end
