{
  "name": "pickplay",
  "main": "expo-router/entry",
  "version": "1.2.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas-build-pre-install": "npm install --include=dev --legacy-peer-deps",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:ios": "echo 'iOS 빌드는 GitHub Actions에서 자동으로 실행됩니다'",
    "build:android": "eas build --platform android",
    "build:ios-local": "eas build --platform ios",
    "submit:ios": "echo 'iOS 제출은 GitHub Actions에서 자동으로 실행됩니다'",
    "submit:android": "eas submit --platform android",
    "deploy:tag": "git tag v$(node -p \"require('./package.json').version\") && git push origin v$(node -p \"require('./package.json').version\")",
    "push:send-daily": "node ./scripts/send-daily-push.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-firebase/app": "^21.0.0",
    "@react-native-firebase/app-check": "^21.0.0",
    "@react-native-firebase/auth": "^21.0.0",
    "@react-native-firebase/firestore": "^21.0.0",
    "@react-native-firebase/functions": "^21.0.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "dayjs": "^1.11.15",
    "expo": "~52.0.0",
    "expo-blur": "~14.0.3",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.20",
    "expo-device": "~7.0.3",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image": "~2.0.7",
    "expo-linking": "~7.0.5",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.21",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.1",
    "expo-symbols": "~0.2.2",
    "expo-system-ui": "~4.0.9",
    "expo-tracking-transparency": "~5.1.1",
    "expo-updates": "~0.27.4",
    "expo-web-browser": "~14.0.2",
    "firebase": "^11.3.0",
    "lottie-react-native": "7.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-google-mobile-ads": "^13.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5",
    "react-native-worklets": "^0.5.1",
    "patch-package": "^8.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.12",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~8.0.1",
    "expo-server-sdk": "^3.15.0",
    "firebase-admin": "^12.7.0",
    "jest": "~29.7.0",
    "react-test-renderer": "18.3.1",
    "ts-jest": "^29.4.4",
    "typescript": "~5.8.3"
  },
  "overrides": {},
  "private": true
}
