{
  "name": "pickplay",
  "main": "expo-router/entry",
  "version": "2.1.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas-build-pre-install": "npm install --include=dev --legacy-peer-deps",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:ios": "echo 'iOS 빌드는 GitHub Actions에서 자동으로 실행됩니다'",
    "build:android": "eas build --platform android",
    "build:ios-local": "eas build --platform ios",
    "submit:ios": "echo 'iOS 제출은 GitHub Actions에서 자동으로 실행됩니다'",
    "submit:android": "eas submit --platform android",
    "deploy:tag": "git tag v$(node -p \"require('./package.json').version\") && git push origin v$(node -p \"require('./package.json').version\")",
    "push:send-daily": "node ./scripts/send-daily-push.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-firebase/app": "^21.0.0",
    "@react-native-firebase/app-check": "^21.0.0",
    "@react-native-firebase/auth": "^21.0.0",
    "@react-native-firebase/firestore": "^21.0.0",
    "@react-native-firebase/functions": "^21.0.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.0.14",
    "dayjs": "^1.11.15",
    "expo": "~53.0.0",
    "expo-application": "~6.1.5",
    "expo-blur": "~14.1.5",
    "expo-build-properties": "~0.14.8",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-device": "~7.1.4",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.1",
    "expo-linking": "~7.1.7",
    "expo-modules-autolinking": "~2.1.0",
    "expo-modules-core": "~2.5.0",
    "expo-notifications": "~0.31.4",
    "expo-router": "~5.1.10",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.11",
    "expo-tracking-transparency": "~5.2.4",
    "expo-updates": "~0.28.17",
    "expo-web-browser": "~14.2.0",
    "firebase": "^11.3.0",
    "lottie-react-native": "7.2.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-google-mobile-ads": "^13.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.12",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~8.0.1",
    "expo-server-sdk": "^3.15.0",
    "firebase-admin": "^12.7.0",
    "fs-extra": "^11.3.3",
    "jest": "~29.7.0",
    "react-test-renderer": "18.3.1",
    "ts-jest": "^29.4.4",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "react-native-worklets": false
  },
  "private": true
}
