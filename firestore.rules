// --- PickPlay Firestore Rules ---
// App Version: 3.0 (Anima Code Update)
// Last Updated: 2025-12-27
// - 'answers'와 'logs' 컬렉션에 대한 보안 규칙을 추가하여 Anima Code 기능을 지원합니다.
// - 투표 저장 문제 해결을 위해 시뮬레이터 관련 필드 제거
// - 푸쉬로그 컬렉션을 위한 규칙 업데이트
// - votes(집계로그)삭제
// - 라이브픽 추가
// - eviceUID 저장 추가
// - 연동하기 추가

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    
    // 관리자 이메일 체크 함수
    function isAdmin() { 
      return request.auth != null && 
             request.auth.token.email in [
               'cream83779@gmail.com', 
               'kwcc2020@naver.com'
             ];
    }

    // 질문 데이터
    match /questions/{questionId} {
      allow read: if signedIn();
      allow write: if isAdmin(); // 관리자 쓰기 권한 추가
    }

    // 사용자 데이터
    match /users/{uid} {
      // get: 자신의 문서는 항상 읽기 가능 (deviceUID 있든 없든 상관없이)
      // 기존 앱과 새 앱 모두 지원
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      
      // list: 쿼리용 (deviceUID로 복구할 때 사용)
      // 자신의 문서 또는 deviceUID가 있는 문서, 또는 deviceUID가 없는 이전 버전 문서도 읽기 가능
      allow list: if signedIn() && (
        request.auth.uid == uid ||
        isAdmin() ||
        (resource.data.deviceUID != null && resource.data.deviceUID is string) ||
        (resource.data.deviceUID == null) // deviceUID가 없는 이전 버전 문서도 허용
      );
      
      // 초기 생성: 기본 필드만 설정 가능
      // deviceUID는 선택적 필드 (기존 앱은 없고, 새 앱은 있음)
      allow create: if signedIn() 
        && request.auth.uid == uid
        && (
          // 기존 앱: deviceUID 없이 생성 (신규 사용자만)
          (request.resource.data.keys().hasOnly(['uid', 'nickname', 'points', 'streakCount', 'totalSelections', 'lastAnswerDate', 'createdAt', 'characterId', 'adjective1', 'adjective2', 'tutorial', 'tutorialChoice'])
            && request.resource.data.points == 0
            && request.resource.data.streakCount == 0
            && request.resource.data.totalSelections == 0) ||
          // 새 앱: deviceUID 포함하여 생성 (신규 사용자만)
          (request.resource.data.keys().hasOnly(['uid', 'nickname', 'points', 'streakCount', 'totalSelections', 'lastAnswerDate', 'createdAt', 'characterId', 'adjective1', 'adjective2', 'tutorial', 'deviceUID', 'tutorialChoice'])
            && request.resource.data.points == 0
            && request.resource.data.streakCount == 0
            && request.resource.data.totalSelections == 0
            && (request.resource.data.deviceUID == null || request.resource.data.deviceUID is string)) ||
          // 복구 시나리오: deviceUID가 있고 기존 사용자 데이터를 복구하는 경우
          // (points, streakCount, totalSelections가 0이 아니어도 허용)
          (request.resource.data.deviceUID is string
            && request.resource.data.deviceUID.size() > 0
            && request.resource.data.uid is string
            && request.resource.data.nickname is string
            && request.resource.data.points is int
            && request.resource.data.points >= 0
            && request.resource.data.streakCount is int
            && request.resource.data.streakCount >= 0
            && request.resource.data.totalSelections is int
            && request.resource.data.totalSelections >= 0
            && request.resource.data.createdAt != null
            && request.resource.data.keys().hasAny(['characterId', 'adjective1', 'adjective2', 'tutorial', 'tutorialChoice']))
        );
      
      // 업데이트: 필드별 세밀한 권한 제어
      // - 일반 사용자는 자신의 문서만, 정해진 패턴으로만 수정 가능
      // - 관리자는 다른 사용자의 points를 늘려줄 수 있음 (주간 TOP 보상 등)
      allow update: if signedIn() && (
        // [일반 사용자용] 자신의 문서만 업데이트 허용
        (
          request.auth.uid == uid &&
          (
            // 1. 닉네임만 수정하는 경우 (사용자가 직접 수정 가능)
            (request.resource.data.diff(resource.data).changedKeys().hasOnly(['nickname'])
              && request.resource.data.nickname is string
              && request.resource.data.nickname.size() > 0
              && request.resource.data.nickname.size() <= 20) ||
            
            // 2. deviceUID 추가 (기존 사용자 문서에 deviceUID가 없을 때 추가)
            (request.resource.data.diff(resource.data).changedKeys().hasOnly(['deviceUID'])
              && resource.data.deviceUID == null
              && request.resource.data.deviceUID is string) ||
            
            // 3. 포인트 변경 (증가는 최대 1000P, 감소는 최대 2000P까지만)
            (request.resource.data.diff(resource.data).changedKeys().hasOnly(['points'])
              && (
                // 증가: 최대 1000P
                (request.resource.data.points >= resource.data.points
                  && request.resource.data.points - resource.data.points <= 1000) ||
                // 감소: 최대 2000P (라이브픽 질문 생성, 보상 교환 등)
                (request.resource.data.points < resource.data.points
                  && resource.data.points - request.resource.data.points <= 2000
                  && request.resource.data.points >= 0)
              )) ||
            
            // 4. 포인트와 튜토리얼 보상 상태 동시 업데이트 (튜토리얼 완료 시)
            (request.resource.data.diff(resource.data).changedKeys().hasOnly(['points', 'tutorial'])
              && request.resource.data.points >= resource.data.points
              && request.resource.data.points - resource.data.points <= 1000
              && request.resource.data.tutorial.rewardGiven500 == true
              && resource.data.tutorial.rewardGiven500 == false) ||
            
            // 5. 튜토리얼 상태만 업데이트 (미션 완료 시)
            (request.resource.data.diff(resource.data).changedKeys().hasOnly(['tutorial'])
              && (
                // mainAnswered가 false에서 true로 변경
                (request.resource.data.tutorial.mainAnswered == true 
                  && resource.data.tutorial.mainAnswered == false) ||
                // livepickParticipated가 false에서 true로 변경
                (request.resource.data.tutorial.livepickParticipated == true 
                  && resource.data.tutorial.livepickParticipated == false) ||
                // livepickCreated가 false에서 true로 변경
                (request.resource.data.tutorial.livepickCreated == true 
                  && resource.data.tutorial.livepickCreated == false) ||
                // rewardGiven500이 false에서 true로 변경
                (request.resource.data.tutorial.rewardGiven500 == true 
                  && resource.data.tutorial.rewardGiven500 == false)
              )) ||
            
            // 6. 게임 로직에서 자동 업데이트되는 필드들
            //    - 답변 제출 시: totalSelections, streakCount, lastAnswerDate만 업데이트
            (request.resource.data.diff(resource.data).changedKeys().hasOnly(['totalSelections', 'streakCount', 'lastAnswerDate'])
              && request.resource.data.streakCount is int
              && request.resource.data.streakCount >= 0 // 리셋(감소)도 허용
              && request.resource.data.streakCount <= 365 // 비정상적으로 큰 값 방지
              && request.resource.data.totalSelections >= resource.data.totalSelections // 총 선택 수는 증가만
              && request.resource.data.totalSelections == resource.data.totalSelections + 1) || // 정확히 1 증가해야 함
            
            // 7. 포인트 변경 (포인트와 함께 다른 필드 업데이트 가능)
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'streakCount', 'totalSelections', 'lastAnswerDate', 'characterId', 'adjective1', 'adjective2'])
              && request.resource.data.points >= resource.data.points // 포인트는 증가만
              && request.resource.data.points - resource.data.points <= 1000 // 한 번에 최대 1000P
              && request.resource.data.streakCount >= resource.data.streakCount // 연속 참여는 증가 또는 유지
              && request.resource.data.totalSelections >= resource.data.totalSelections) || // 총 선택 수는 증가만
            
            // 8. 애니마코드 업데이트 (characterId, adjective1, adjective2만)
            (request.resource.data.diff(resource.data).changedKeys().hasOnly(['characterId', 'adjective1', 'adjective2'])
              && (request.resource.data.characterId == null || request.resource.data.characterId is string)
              && (request.resource.data.adjective1 == null || request.resource.data.adjective1 is string)
              && (request.resource.data.adjective2 == null || request.resource.data.adjective2 is string)) ||

            // 9. 사용자 알림 설정(notificationEnabled)만 변경
            (request.resource.data.diff(resource.data).changedKeys().hasOnly(['notificationEnabled'])
              && (request.resource.data.notificationEnabled == true || request.resource.data.notificationEnabled == false)) ||

            // 10. 전화번호 인증 정보 추가/업데이트 (phoneNumber, phoneVerified, phoneVerifiedAt)
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phoneNumber', 'phoneVerified', 'phoneVerifiedAt'])
              && request.resource.data.phoneNumber is string
              && request.resource.data.phoneNumber.size() > 0
              && request.resource.data.phoneVerified == true)
            ||
            // 11. 튜토리얼 선택 상태(tutorialChoice)만 변경 (pending/opt_in/opt_out)
            (request.resource.data.diff(resource.data).changedKeys().hasOnly(['tutorialChoice'])
              && (request.resource.data.tutorialChoice in ['pending', 'opt_in', 'opt_out']))
            ||
            // 12. opt-in 선택 시 tutorial 초기 구조 생성까지 함께 허용
            // - setTutorialChoice()가 tutorialChoice + tutorial(모두 false) 를 같이 업데이트함
            (request.resource.data.diff(resource.data).changedKeys().hasOnly(['tutorialChoice', 'tutorial'])
              && resource.data.tutorial == null
              && request.resource.data.tutorialChoice == 'opt_in'
              && request.resource.data.tutorial.mainAnswered == false
              && request.resource.data.tutorial.livepickParticipated == false
              && request.resource.data.tutorial.livepickCreated == false
              && request.resource.data.tutorial.rewardGiven500 == false)
          )
        ) ||
        // [관리자용] 어떤 사용자의 points든 증가만 가능 (주간 TOP 보상 등)
        (
          isAdmin()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['points'])
          && request.resource.data.points is number
          && request.resource.data.points >= resource.data.get('points', 0)
          && request.resource.data.points - resource.data.get('points', 0) <= 10000
          && request.resource.data.points >= 0
        )
      );
      
      // 삭제는 관리자만
      allow delete: if isAdmin();
    }
    
    // [강화] answers 컬렉션 규칙 (Anima Code)
    // 2025-10-09: rewarded 필드 도입에 따른 규칙 보완
    match /answers/{answerDocId} {
      // 문서 ID에서 uid와 questionId를 분리하는 함수
      function getUid() { return answerDocId.split('_')[0]; }
      function getQuestionId() { return answerDocId.split('_')[1]; }

      // 본인만 자신의 답변을 읽을 수 있음 (집계를 위해 모든 인증된 사용자가 읽기 가능)
      allow read: if signedIn();

      // 생성 규칙: 아래 모든 조건을 만족해야 함
      allow create: if signedIn() 
        // 1. 인증된 사용자가 본인 문서에만 쓸 수 있는가?
        && request.auth.uid == getUid()
        // 2. 문서 ID와 내용의 uid, questionId가 모두 일치하는가?
        && request.resource.data.uid == getUid()
        && request.resource.data.question_id == getQuestionId()
        // 3. 데이터 스키마와 타입이 정확한가?
        //    rewarded 필드를 신규로 허용 (광고 시청 후 보상 완료 플래그)
        && request.resource.data.keys().hasOnly(['uid', 'question_id', 'selected_option_index', 'selected_option_text', 'tags', 'answeredAt', 'rewarded'])
        && request.resource.data.uid is string
        && request.resource.data.question_id is string
        && request.resource.data.selected_option_index in [0, 1]
        && request.resource.data.selected_option_text is string
        && request.resource.data.tags is list
        && (request.resource.data.rewarded == null || request.resource.data.rewarded is bool)
        && request.resource.data.answeredAt == request.time  // 서버 타임스탬프 검증
        // 4. 존재하는 질문에 대한 답변인가?
        && exists(/databases/$(database)/documents/questions/$(getQuestionId()));

      // 업데이트 규칙: 
      // 1. 보상 완료 플래그(rewarded)만 본인이 true로 갱신 가능
      // 2. AI 태그(tags) 필드 업데이트 가능 (백그라운드에서 생성된 태그 저장을 위해)
      allow update: if signedIn() && request.auth.uid == getUid() && (
        // Case 1: rewarded 필드만 업데이트 (보상 완료 플래그)
        (resource.data.diff(request.resource.data).changedKeys().hasOnly(['rewarded'])
          && resource.data.diff(request.resource.data).addedKeys().size() == 0
          && resource.data.diff(request.resource.data).removedKeys().size() == 0
          && request.resource.data.rewarded is bool) ||
        // Case 2: tags 필드만 업데이트 (AI 태그 생성 후)
        (resource.data.diff(request.resource.data).changedKeys().hasOnly(['tags'])
          && resource.data.diff(request.resource.data).addedKeys().size() == 0
          && resource.data.diff(request.resource.data).removedKeys().size() == 0
          && request.resource.data.tags is list
          && resource.data.tags.size() == 0) // 빈 배열에서만 업데이트 가능 (초기 저장 후 AI 태그 추가만 허용)
      );

      // 삭제/기타 변경은 관리자만 가능
      allow delete: if isAdmin();
    }

    // [강화] logs 컬렉션 규칙 (Anima Code)
    match /logs/{logId} {
      // 생성: 본인만, 그리고 정해진 스키마/타입으로만 가능
      allow create: if signedIn() 
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.keys().hasOnly(['uid', 'action', 'details', 'createdAt'])
        && request.resource.data.uid is string
        && request.resource.data.action is string
        && request.resource.data.details is map;
      
      // 로그는 관리자만 읽을 수 있고, 수정/삭제는 불가능
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // votes 컬렉션은 더 이상 쓰지 않습니다(경고 제거를 위해 쓰기 차단)
    match /votes/{id} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    // Expo 푸시 토큰 저장 컬렉션
    // 앱 클라이언트가 자신의 문서만 읽기/쓰기 가능
    match /user_push_tokens/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin(); // 관리자 읽기 권한 추가
    }
    
    // config 컬렉션은 모든 사용자가 읽을 수 있음 (쓰기는 불가)
		match /config/{document=**} {
  		allow read: if true;
  		allow write: if isAdmin(); // 관리자만 쓰기 가능
    }
    // 푸시 로그 컬렉션
    match /push_logs/{logId} {
      allow read: if isAdmin(); // 관리자만 읽기 가능
      allow write: if false; // 서버에서만 쓰기 (Cloud Functions/Run)
    }
    
    // ============================================
    // LivePick 컬렉션 규칙
    // ============================================
    
    // LivePick 질문 컬렉션
    match /livepick_questions/{questionId} {
      // 모든 인증된 사용자가 읽기 가능 (질문 목록, 상세 조회)
      allow read: if signedIn();
      
      // [1단계] 생성: 인증 + 작성자 UID 일치만 검증
      // - 최소한 "내 계정으로만 질문을 만든다"는 조건은 보장
      // - 나머지 필드/타입 검증은 이후 단계에서 점진적으로 추가 예정
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.createdBy;
      
      // 업데이트: 
      // 1. 관리자는 status 변경 가능
      // 2. 참여자 수 등 통계 업데이트는 서버/클라이언트에서 가능 (참여자 수는 항상 증가만 가능)
      allow update: if signedIn() && (
        // 관리자는 status만 변경 가능
        (isAdmin() 
          && request.resource.data.diff(resource.data).unchangedKeys().hasAll(['createdBy', 'title', 'option1', 'option2', 'pointDeducted', 'createdAt', 'participantCount', 'option1Count', 'option2Count', 'rewardGiven'])
          && request.resource.data.status in ['active', 'closed']) ||
        // 일반 사용자는 참여 시 통계만 업데이트 가능 (인증된 사용자 누구나)
        (request.resource.data.diff(resource.data).unchangedKeys().hasAll(['createdBy', 'title', 'option1', 'option2', 'pointDeducted', 'createdAt', 'status'])
          && request.resource.data.participantCount >= resource.data.participantCount
          && request.resource.data.option1Count >= resource.data.option1Count
          && request.resource.data.option2Count >= resource.data.option2Count)
      );
      
      // 삭제는 관리자만
      allow delete: if isAdmin();
    }

    // 주간 TOP 질문 캐시 (지난 주 한 번만 계산 후 저장, 이후 조회만)
    match /livepick_weekly_winners/{weekKey} {
      allow read: if signedIn();
      // 생성: 인증된 사용자가 해당 주(weekKey) 캐시 문서만 생성 가능 (문서 ID = weekKey)
      allow create: if signedIn()
        && request.resource.data.weekKey == weekKey;
      allow update, delete: if isAdmin();
    }

    // 포인트 적립/소멸 내역
    match /point_history/{docId} {
      // 단일 문서 읽기: 본인 것만
      allow get: if signedIn() && request.auth.uid == resource.data.uid;
      // 쿼리(list): 인증된 사용자 허용
      allow list: if signedIn();
      
      // 생성: 본인 내역 또는 관리자 대신 기록 (주간 TOP 보상 등)
      allow create: if (
        (signedIn()
          && request.auth.uid == request.resource.data.uid
          && request.resource.data.keys().hasAll(['uid', 'amount', 'reason', 'createdAt'])
          && request.resource.data.uid is string
          && request.resource.data.amount is number
          && request.resource.data.reason is string
          && (request.resource.data.description == null || request.resource.data.description is string))
        || (isAdmin()
          && request.resource.data.keys().hasAll(['uid', 'amount', 'reason', 'createdAt'])
          && request.resource.data.uid is string
          && request.resource.data.amount is number
          && request.resource.data.reason is string
          && (request.resource.data.description == null || request.resource.data.description is string))
      );
      
      // 수정/삭제는 금지 (한 번 기록된 내역은 변경 불가)
      allow update, delete: if false;
    }
    
    // LivePick 참여 기록 컬렉션
    match /livepick_participations/{participationId} {
      // 문서 ID 형식: {uid}_{questionId}
      function getUid() { return participationId.split('_')[0]; }
      
      // 읽기: 본인만 읽기 가능
      // - 단일 문서 읽기(get): 문서 ID의 uid 부분 확인 (보안 유지)
      // - 쿼리(list): 인증된 사용자에게 허용
      //   이유: 쿼리가 where('uid', '==', uid)로 필터링되므로 결과는 본인의 문서만 반환됨
      //   Firestore Rules는 쿼리 조건을 직접 검증할 수 없지만, 쿼리 결과는 서버에서 필터링됨
      //   단일 문서 접근은 여전히 문서 ID 기반으로 검증하므로 보안 유지
      allow get: if signedIn() && request.auth.uid == getUid();
      // 쿼리는 where('uid', '==', uid)로 필터링되므로 결과는 본인의 문서만 포함
      allow list: if signedIn();
      
      // 생성: 본인만 참여 기록 생성 가능
      allow create: if signedIn()
        && request.auth.uid == getUid()
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.keys().hasAll(['uid', 'questionId', 'selectedOption', 'basicRewardReceived', 'ladderGamePlayed', 'ladderReward', 'participatedAt'])
        && request.resource.data.uid is string
        && request.resource.data.questionId is string
        && request.resource.data.selectedOption in [1, 2]
        && request.resource.data.basicRewardReceived == false
        && request.resource.data.ladderGamePlayed == false;
      
      // 업데이트: 본인만 보상 수령 상태 업데이트 가능
      allow update: if signedIn()
        && request.auth.uid == getUid()
        && resource.data.uid == request.resource.data.uid
        && resource.data.questionId == request.resource.data.questionId
        && resource.data.selectedOption == request.resource.data.selectedOption;
      
      // 삭제는 관리자만
      allow delete: if isAdmin();
    }
    
    // LivePick 보상 기록 컬렉션
    match /livepick_rewards/{rewardId} {
      // 읽기: 관리자 또는 질문 생성자만 읽기 가능
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.questionOwner == request.auth.uid
      );
      
      // 쓰기는 서버(Cloud Functions)에서만 가능
      allow create, update, delete: if false;
    }
    
    // LivePick 신고 컬렉션
    match /livepick_reports/{reportId} {
      // 문서 ID 형식: {uid}_{questionId}
      function getUid() { return reportId.split('_')[0]; }
      
      // 읽기: 관리자 또는 본인(자기 신고 문서)만 가능
      allow read: if isAdmin() || (signedIn() && request.auth.uid == getUid());
      
      // 생성: 인증된 사용자면 누구나 가능 (이미 리포트가 있으면 get()에서 막힘)
      allow create: if signedIn();
      
      // 업데이트: 관리자만 상태 업데이트 가능 (신고 처리용)
      allow update: if isAdmin()
        && resource.data.uid == request.resource.data.uid
        && resource.data.questionId == request.resource.data.questionId
        && resource.data.reason == request.resource.data.reason
        && request.resource.data.status in ['pending', 'reviewed', 'dismissed'];
      
      // 삭제: 관리자만 가능
      allow delete: if isAdmin();
    }
    
    // ============================================
    // 사용자 알림 컬렉션
    // ============================================
    
    match /user_notifications/{notificationId} {
      // 단일 문서 읽기: 본인만
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      // 쿼리(list): where('uid', '==', uid)로 필터링되므로 인증된 사용자에게 허용
      // 결과는 서버에서 필터링되므로 본인의 문서만 반환됨
      allow list: if signedIn();
      
      // 생성: 서버(Cloud Functions)에서만 가능
      allow create: if false;
      
      // 업데이트: 본인만 읽음 상태 업데이트 가능
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      
      // 삭제는 관리자만
      allow delete: if isAdmin();
    }
    
    // ============================================
    // 보상 교환 관련 컬렉션
    // ============================================
    
    // 교환 가능한 상품 목록
    match /reward_items/{rewardId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    
    // 교환 신청 내역
    match /exchange_requests/{requestId} {
      // 본인의 신청 내역만 읽기 가능
      allow read: if signedIn() && (request.auth.uid == resource.data.uid || isAdmin());
      
      // 신청 생성: 본인만 가능, 필수 필드 검증
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rewardItemId is string
        && request.resource.data.rewardTitle is string
        && request.resource.data.usedPoints is int
        && request.resource.data.usedPoints > 0
        && request.resource.data.status == 'requested'
        && request.resource.data.createdAt != null;
      
      // 업데이트: 관리자만 가능 (상태 변경 등)
      allow update: if isAdmin();
      
      // 삭제: 관리자만 가능
      allow delete: if isAdmin();
    }
    
    // ============================================
    // 기기 이전 컬렉션
    // ============================================
    
    match /device_transfers/{uid} {
      // 읽기: 본인 또는 관리자만 가능 (연동 실행 시 다른 사용자가 읽을 수 있어야 함)
      // 주의: 연동 실행 시 sourceUID로 읽어야 하므로, 인증된 사용자면 누구나 읽기 가능
      // (비밀번호로 보호되므로 보안 문제 없음)
      allow get: if signedIn();
      allow list: if isAdmin(); // 관리자만 목록 조회 가능
      
      // 생성: 본인만 자신의 UID로 연동 준비 정보 생성 가능
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.password is string
        && request.resource.data.password.size() >= 8
        && request.resource.data.password.size() <= 10
        && request.resource.data.used == false
        && (request.resource.data.createdAt == request.time || request.resource.data.createdAt is timestamp)
        && request.resource.data.expiresAt is timestamp;
      
      // 업데이트: 
      // 1. 연동 완료 시 used 플래그와 transferredTo 업데이트 (used: false → true)
      // 2. 연동 준비 재생성 시 전체 필드 업데이트 (used: false 또는 true인 경우 모두 가능)
      allow update: if signedIn() && (
        (request.auth.uid == uid || isAdmin()) && (
          // 케이스 1: 연동 완료 (used: false → true)
          (resource.data.used == false
            && request.resource.data.used == true
            && request.resource.data.diff(resource.data).unchangedKeys().hasAll(['uid', 'password', 'createdAt', 'expiresAt'])
            && (request.resource.data.transferredTo == null || request.resource.data.transferredTo is string)) ||
          // 케이스 2: 연동 준비 재생성 (used: false 또는 true인 경우 모두 전체 필드 업데이트 가능)
          (request.resource.data.used == false
            && request.resource.data.uid == uid
            && request.resource.data.password is string
            && request.resource.data.password.size() >= 8
            && request.resource.data.password.size() <= 10
            && (request.resource.data.createdAt == request.time || request.resource.data.createdAt is timestamp)
            && request.resource.data.expiresAt is timestamp)
        )
      );
      
      // 삭제는 관리자만
      allow delete: if isAdmin();
    }
    
  }
}